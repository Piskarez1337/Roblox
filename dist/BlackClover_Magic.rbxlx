      <Item class="ModuleScript" referent="857">
        <Properties>
          <string name="Name">AwakeningManager</string>
          <string name="Source"><![CDATA[--!nonstrict
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicConfig)
local Registry = require(script.Parent.Registry)
local Awakening = {}
function Awakening:Stop(state, now)
	if not state.Awakened then return end
	state.Awakened = false
	if self.Cancel then self.Cancel(state) end
	state.BusyUntil = math.max(now, state.AttackReady)
	state.LastManaUse = now
	state.Model:SetAttribute("Awakened", false)
	state.Model:SetAttribute("TransformStart", 0)
	state.Model:SetAttribute("MeleeProfile", state.MagicId == "Anti" and "Sword" or "Fist")
end
function Awakening:Toggle(state, now)
	if state.Awakened then self:Stop(state, now); return true end
	local class = Config.Classes[state.MagicId]
	if not class or class.Drain <= 0 or state.Mana < Config.ActivationMinimum or now < state.AwakeningReady
		or now < state.StunUntil or now < state.RootedUntil or now < state.SuppressedUntil or now < state.BusyUntil then return false end
	if self.Cancel then self.Cancel(state) end
	state.Awakened = true
	state.AwakeningReady = now + Config.ToggleCooldown
	state.BusyUntil = now + Config.TransformTime
	state.Blocking = false
	state.Model:SetAttribute("Awakened", true)
	state.Model:SetAttribute("TransformStart", now)
	state.Model:SetAttribute("AwakeningReady", state.AwakeningReady)
	state.Model:SetAttribute("MeleeProfile", state.MagicId == "Anti" and "Sword" or (state.MagicId == "Water" and "Spear" or (state.MagicId == "Wind" and "WindWeapon" or "Fist")))
	return true
end
function Awakening:Step(now)
	for _, state in Registry.Actors do
		if state.Awakened and (not Registry:Alive(state) or state.Mana <= 0 or now < state.SuppressedUntil) then self:Stop(state, now) end
	end
end
return Awakening
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="858">
        <Properties>
          <string name="Name">Bootstrap</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local PhysicsService = game:GetService("PhysicsService")
local Config = require(ReplicatedStorage.BlackClover.Shared.Config)
local Rules = require(ReplicatedStorage.BlackClover.Shared.Rules)
local Registry = require(script.Parent.Registry)
local Movement = require(script.Parent.MovementSystem)
local Combat = require(script.Parent.CombatSystem)
local EnemyAI = require(script.Parent.EnemyAI)
local Magic = require(script.Parent.MagicManager)
local remotes = ReplicatedStorage.BlackClover.Remotes
local request, fx = remotes.Action, remotes.FX
local buckets, connections, fountains = {}, {}, {}
Magic:Start(fx, remotes.MagicFX)

PhysicsService:RegisterCollisionGroup("BCActors")
PhysicsService:CollisionGroupSetCollidable("BCActors", "BCActors", false)
Players.RespawnTime = 3

local function characterAdded(player, model)
	local humanoid = model:WaitForChild("Humanoid", 15)
	local root = model:WaitForChild("HumanoidRootPart", 15)
	if not humanoid or not root or player.Character ~= model then return end
	if humanoid.RigType ~= Enum.HumanoidRigType.R15 then
		warn("Black Clover requires R15; use the supplied StarterCharacter")
		return
	end
	local old = Registry.ByPlayer[player]
	if old then Registry:Remove(old.Model) end
	local state = Registry:Add(model, player, "Player")
	Magic:Initialize(state)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then part.CollisionGroup = "BCActors" end
	end
	table.insert(state.Connections, model.DescendantAdded:Connect(function(part)
		if part:IsA("BasePart") then part.CollisionGroup = "BCActors" end
	end))
	table.insert(state.Connections, humanoid.Died:Connect(function()
		Magic:Death(state)
		state.Generation += 1
		state.Blocking = false
		state.Sprinting = false
		model:SetAttribute("AttackStart", 0)
		Movement:StopDash(state)
		Registry:Publish(state)
	end))
end

local function playerAdded(player)
	buckets[player] = { Tokens = Config.Network.Burst, Time = workspace:GetServerTimeNow() }
	connections[player] = {
		player.CharacterAdded:Connect(function(model) characterAdded(player, model) end),
		player.CharacterRemoving:Connect(function(model) Registry:Remove(model) end),
	}
	if player.Character then task.spawn(characterAdded, player, player.Character) end
end

Players.PlayerAdded:Connect(playerAdded)
Players.PlayerRemoving:Connect(function(player)
	local state = Registry.ByPlayer[player]
	if state then Registry:Remove(state.Model) end
	for _, connection in connections[player] or {} do connection:Disconnect() end
	buckets[player], connections[player], fountains[player] = nil, nil, nil
	Magic.Profiles[player] = nil
end)
for _, player in Players:GetPlayers() do playerAdded(player) end

request.OnServerEvent:Connect(function(player, action, argument)
	if type(action) ~= "string" or #action > 12 then return end
	local state, bucket = Registry.ByPlayer[player], buckets[player]
	if not Registry:Alive(state) or not bucket then return end
	local now = workspace:GetServerTimeNow()
	local allowed
	allowed, bucket.Tokens = Rules.consumeToken(bucket.Tokens, bucket.Time, now, Config.Network.Rate, Config.Network.Burst)
	bucket.Time = now
	if not allowed then return end
	if not Movement:ValidateMotion(state, now) then return end
	local accepted = false
	if action == "Attack" and argument == nil then
		accepted = Combat:Attack(state, now, fx)
	elseif action == "Dash" then
		accepted = Movement:Dash(state, argument, now, fx)
	elseif action == "Block" and type(argument) == "boolean" then
		accepted = Combat:Block(state, argument, now)
	elseif action == "Sprint" and type(argument) == "boolean" then
		state.Sprinting = argument and not state.Blocking
		Registry:Publish(state)
		accepted = true
	else
		accepted = Magic:Request(state, action, argument, now)
	end
	if not accepted then fx:FireClient(player, "Rejected", action) end
end)

local fountain = workspace:WaitForChild("TrainingGround"):FindFirstChild("RecoveryPrompt", true)
if fountain and fountain:IsA("ProximityPrompt") then
	fountain.Triggered:Connect(function(player)
		local state, now = Registry.ByPlayer[player], workspace:GetServerTimeNow()
		if not Registry:Alive(state) or now < (fountains[player] or 0) then return end
		if (state.Root.Position - fountain.Parent.Position).Magnitude > Config.Training.FountainDistance then return end
		state.Humanoid.Health = state.Humanoid.MaxHealth
		state.Mana, state.Guard = state.MaxMana, Config.Combat.GuardMax
		fountains[player] = now + Config.Training.FountainCooldown
		Registry:Publish(state)
		fx:FireClient(player, "Restored", state.Model, state.Root.Position)
	end)
end

EnemyAI:Start(fx)
local publishElapsed, aiElapsed = 0, 0
RunService.Heartbeat:Connect(function(dt)
	local now = workspace:GetServerTimeNow()
	Registry:Step(dt, now)
	Magic:Step(dt, now)
	Movement:Step(dt, now)
	publishElapsed += dt
	aiElapsed += dt
	if aiElapsed >= 0.1 then aiElapsed = 0; EnemyAI:Step(now) end
	if publishElapsed >= Config.Network.StateInterval then
		publishElapsed = 0
		for _, state in Registry.Actors do Registry:Publish(state) end
	end
end)

print("[Black Clover] Core + 7 magic classes / 44 spells initialized. Studio integration checks still required.")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="859">
        <Properties>
          <string name="Name">ClashManager</string>
          <string name="Source"><![CDATA[--!nonstrict
local Rules = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicRules)
local World = require(script.Parent.MagicWorld)
local Clash = {}
function Clash:Step(projectiles)
	local list = {}
	for _, p in projectiles.Items do table.insert(list, p) end
	for i = 1, #list do
		local a = list[i]
		if a.Removed then continue end
		for j = i + 1, #list do
			local b = list[j]
			if a.Removed or b.Removed or a.Owner == b.Owner then continue end
			local r = a.Previous - b.Previous
			local v = (a.Next - a.Previous) - (b.Next - b.Previous)
			local collided, t = Rules.sweptHit(r.X, r.Y, r.Z, v.X, v.Y, v.Z, a.Radius + b.Radius)
			if not collided then continue end
			local point = a.Previous:Lerp(a.Next, t)
			local outcome, remaining = Rules.clash(a.Power, b.Power, a.Element, b.Element)
			World:Pulse("Clash", point, outcome == "Equal" and "Stars" or (outcome == "A" and a.Element or b.Element), math.clamp((a.Power + b.Power) / 12, 5, 24))
			if outcome == "Equal" then projectiles:Remove(a); projectiles:Remove(b)
			else
				local winner, loser = outcome == "A" and a or b, outcome == "A" and b or a
				winner.Multiplier *= math.clamp(remaining / math.max(1, winner.Power), .3, .85)
				winner.Power = remaining
				if winner.Element == "Water" and loser.Element == "Ice" then
					winner.Speed *= .7
					winner.Root:SetAttribute("Frosted", true)
				end
				if loser.Element == "Wind" and winner.Element == "Water" then
					local shifted = winner.Direction + loser.Direction * .45
					if shifted.Magnitude > .01 then winner.Direction = shifted.Unit end
				end
				projectiles:Remove(loser)
			end
		end
	end
end
return Clash
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="860">
        <Properties>
          <string name="Name">CombatSystem</string>
          <string name="Source"><![CDATA[--!nonstrict
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Config)
local Rules = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Rules)
local Registry = require(script.Parent.Registry)
local Hitbox = require(script.Parent.Hitbox)
local Movement = require(script.Parent.MovementSystem)
local Damage = require(script.Parent.DamageService)
local Combat = {}

function Combat:Block(state, enabled, now)
	if not enabled then state.Blocking = false; Registry:Publish(state); return true end
	if not Registry:Alive(state) or not Rules.canAct(state.Humanoid.Health, now, state.BusyUntil, state.StunUntil)
		or state.Guard < 8 or now < state.RootedUntil then return false end
	state.Blocking = true
	state.Sprinting = false
	Registry:Publish(state)
	return true
end

function Combat:ApplyHit(source, target, definition, index, now, fx)
	local multiplier = source.MagicId == "Anti" and 1.15 or (source.MagicId == "Water" and source.Awakened and 1.1 or 1)
	return Damage:Apply(source, target, { Damage = definition.Damage * multiplier, Guard = definition.Guard,
		Stun = definition.Stun, Knockback = definition.Knockback, Lift = index == 4 and 7 or 0, Index = index }, now, fx)
end

function Combat:Attack(state, now, fx)
	if not Registry:Alive(state) or not Rules.canAct(state.Humanoid.Health, now, state.BusyUntil, state.StunUntil)
		or state.Blocking or now < state.RootedUntil or now < state.AttackReady then return false end
	state.Combo = Rules.nextCombo(state.Combo, state.LastAttack, now, Config.Combat.ComboReset)
	state.LastAttack = now
	local index = state.Combo
	local definition = Config.Combat.Attacks[index]
	state.BusyUntil = now + definition.Recovery
	state.AttackReady = state.BusyUntil
	state.Generation += 1
	local generation = state.Generation
	state.Model:SetAttribute("AttackIndex", index)
	state.Model:SetAttribute("AttackStart", now)
	fx:FireAllClients("Swing", state.Model, state.Root.Position, index)
	local hitOnce = {}
	-- Three short overlap samples form one active window. Each victim is hit once.
	for sample = 0, 2 do
		task.delay(definition.Windup + definition.Active * sample / 2, function()
			if not Registry:Alive(state) or state.Generation ~= generation then return end
			local current = workspace:GetServerTimeNow()
			if current < state.StunUntil or not Movement:ValidateMotion(state, current) then return end
			local reach = state.MagicId == "Anti" and 9 or (state.MagicId == "Water" and state.Awakened and 10 or nil)
			for _, target in Hitbox:Find(state, reach) do
				if hitOnce[target] then continue end
				hitOnce[target] = true
				self:ApplyHit(state, target, definition, index, current, fx)
			end
			if self.MagicHook then self.MagicHook(state, definition, hitOnce, current) end
		end)
	end
	return true
end

return Combat
]]></string>
        </Properties>
