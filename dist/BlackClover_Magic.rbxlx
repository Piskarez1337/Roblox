      <Item class="ModuleScript" referent="862">
        <Properties>
          <string name="Name">DamageService</string>
          <string name="Source"><![CDATA[--!nonstrict
local shared = game:GetService("ReplicatedStorage").BlackClover.Shared
local Config, Rules = require(shared.Config), require(shared.Rules)
local Registry = require(script.Parent.Registry)
local Movement = require(script.Parent.MovementSystem)
local Passive = require(script.Parent.PassiveService)
local Targeting = require(script.Parent.MagicHitboxService)
local Damage = {}
function Damage:Apply(source, target, info, now, fx)
	if not Targeting:CanHit(source, target) or target.Model:FindFirstChildOfClass("ForceField") then return 0 end
	local delta = (info.Origin or source.Root.Position) - target.Root.Position
	local direction = delta.Magnitude > .01 and delta.Unit or target.Root.CFrame.LookVector
	local guarding = info.Blockable ~= false and target.Blocking and target.Root.CFrame.LookVector:Dot(direction) >= Config.Combat.BlockFacingDot
	local damage, broken = Passive:Damage(target, info.Damage, info.Element ~= nil), false
	if source.MagicId == "Anti" and not info.Element and now < (source.CounterUntil or 0) then
		damage *= 1.2
		source.CounterUntil = 0
	end
	if target.Shield and now < target.Shield.Until then
		local prevented = math.min(target.Shield.HP, damage * target.Shield.Reduction)
		target.Shield.HP -= prevented
		damage -= prevented
		if target.Shield.HP <= 0 then target.Shield = nil; target.Model:SetAttribute("ShieldVisual", "") end
	end
	if guarding then
		damage, target.Guard, broken = Rules.guardHit(damage, target.Guard, info.Guard or math.max(8, info.Damage * .7), Config.Combat.BlockDamageFactor)
		target.LastGuard = now
	end
	target.LastDamage, source.LastDamage = now, now
	if not guarding or broken then
		target.Blocking = false
		local stun = broken and Config.Combat.GuardBreakStun or (info.Stun or .12)
		target.StunUntil = math.max(target.StunUntil, now + stun)
		if stun > 0 then
			target.Generation += 1
			target.CastGeneration += 1
			target.Model:SetAttribute("CastSpell", "")
			target.Model:SetAttribute("AttackStart", 0)
			target.Model:SetAttribute("HitAt", now)
			Movement:StopDash(target)
		end
		if not target.Root.Anchored and now >= target.RootedUntil then
			target.MotionGrace = now + .7
			target.Root:SetNetworkOwner(nil)
			local push = -Vector3.new(direction.X, 0, direction.Z) * (info.Knockback or 0) * Passive:Knockback(target)
			target.Root:ApplyImpulse((push + Vector3.new(0, info.Lift or 0, 0)) * target.Root.AssemblyMass)
			task.delay(.25, function()
				if Registry:Alive(target) and target.Player and not target.DashDirection and not target.FlightConstraint
					and workspace:GetServerTimeNow() >= target.RootedUntil then target.Root:SetNetworkOwnershipAuto() end
			end)
		end
	end
	local before = target.Humanoid.Health
	target.Humanoid:TakeDamage(damage)
	local dealt = before - target.Humanoid.Health
	if dealt > 0 then
		Passive:AfterHit(source, target, dealt, info.Element, now)
		if info.Suppress then target.SuppressedUntil = math.max(target.SuppressedUntil, now + info.Suppress) end
	end
	Registry:Publish(target)
	if fx then fx:FireAllClients(broken and "GuardBreak" or (guarding and "Block" or "Hit"), target.Model,
		target.Root.Position, dealt, source.Model, info.Index or 1, info.Element) end
	return dealt
end
function Damage:Spell(source, target, spell, now, fx, multiplier, origin)
	return self:Apply(source, target, { Damage = spell.Damage * (multiplier or 1), Element = spell.ElementType,
		Stun = spell.Stun, Knockback = spell.Knockback, Suppress = spell.Suppress, Origin = origin, Index = spell.Awakened and 4 or 1 }, now, fx)
end
return Damage
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="863">
        <Properties>
          <string name="Name">EnemyAI</string>
          <string name="Source"><![CDATA[--!nonstrict
local ServerStorage = game:GetService("ServerStorage")
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Config)
local Registry = require(script.Parent.Registry)
local Combat = require(script.Parent.CombatSystem)
local EnemyAI = { Slots = {}, Folder = nil, FX = nil }

function EnemyAI:Spawn(slot)
	local template = ServerStorage.Actors:FindFirstChild(slot.Kind)
	local model = template:Clone()
	model.Name = slot.Kind == "Dummy" and "Тренировочный манекен" or "Каменный часовой"
	model:PivotTo(slot.CFrame)
	model.Parent = self.Folder
	local state = Registry:Add(model, nil, slot.Kind)
	state.Root:SetNetworkOwner(nil)
	if slot.Kind == "Dummy" then state.Root.Anchored = true end
	slot.State = state
	slot.NextAttack = 0
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then part.CollisionGroup = "BCActors" end
	end
	table.insert(state.Connections, state.Humanoid.Died:Connect(function()
		state.Generation += 1
		task.delay(Config.Training.Respawn, function()
			Registry:Remove(model)
			model:Destroy()
			self:Spawn(slot)
		end)
	end))
end

function EnemyAI:Start(fx)
	self.FX = fx
	self.Folder = Instance.new("Folder")
	self.Folder.Name = "TrainingActors"
	self.Folder.Parent = workspace
	self.Slots = {
		{ Kind = "Dummy", CFrame = CFrame.new(-11, 4, 0) * CFrame.Angles(0, math.pi, 0) },
		{ Kind = "Dummy", CFrame = CFrame.new(11, 4, 0) * CFrame.Angles(0, math.pi, 0) },
		{ Kind = "Enemy", CFrame = CFrame.new(-24, 4, -27) * CFrame.Angles(0, math.pi, 0) },
		{ Kind = "Enemy", CFrame = CFrame.new(24, 4, -27) * CFrame.Angles(0, math.pi, 0) },
	}
	for _, slot in self.Slots do self:Spawn(slot) end
end

function EnemyAI:Step(now)
	for _, slot in self.Slots do
		local state = slot.State
		if slot.Kind ~= "Enemy" or not Registry:Alive(state) or now < state.StunUntil then continue end
		local target, distance = nil, Config.Training.EnemyAggro
		for _, candidate in Registry.Actors do
			if candidate.Kind ~= "Player" and candidate.Kind ~= "Golem" then continue end
			if not Registry:Alive(candidate) then continue end
			if (candidate.Root.Position - slot.CFrame.Position).Magnitude > Config.Training.EnemyLeash then continue end
			local d = (candidate.Root.Position - state.Root.Position).Magnitude
			if d < distance then target, distance = candidate, d end
		end
		if target then
			if distance > 5 then
				state.Humanoid:MoveTo(target.Root.Position)
			else
				state.Humanoid:MoveTo(state.Root.Position)
				if now >= slot.NextAttack and now >= state.BusyUntil then
					local flat = Vector3.new(target.Root.Position.X, state.Root.Position.Y, target.Root.Position.Z)
					if (flat - state.Root.Position).Magnitude > 0.1 then state.Root.CFrame = CFrame.lookAt(state.Root.Position, flat) end
					Combat:Attack(state, now, self.FX)
					slot.NextAttack = now + Config.Training.EnemyAttackGap
				end
			end
		else
			state.Humanoid:MoveTo(slot.CFrame.Position)
		end
	end
end

return EnemyAI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="864">
        <Properties>
          <string name="Name">FieldService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicConfig)
local Registry = require(script.Parent.Registry)
local Hitbox = require(script.Parent.MagicHitboxService)
local Damage = require(script.Parent.DamageService)
local Status = require(script.Parent.StatusService)
local Passive = require(script.Parent.PassiveService)
local Projectiles = require(script.Parent.ProjectileService)
local World = require(script.Parent.MagicWorld)
local Fields = { Items = {}, Reservations = {}, Count = 0, Reserved = 0 }
function Fields:Reserve(context, amount)
	local own = 0
	for _, field in self.Items do if field.Owner == context.Owner then own += 1 end end
	for ctx, n in self.Reservations do if ctx.Owner == context.Owner then own += n end end
	if self.Count + self.Reserved + amount > Config.Limits.Fields or own + amount > Config.Limits.FieldsPerOwner then return false end
	self.Reservations[context] = amount
	self.Reserved += amount
	return true
end
function Fields:Release(context)
	self.Reserved -= self.Reservations[context] or 0
	self.Reservations[context] = nil
end
function Fields:Create(context, kind, position, options)
	local n = self.Reservations[context] or 0
	if n <= 0 then return nil end
	self.Reserved -= 1
	self.Reservations[context] = n > 1 and n - 1 or nil
	if not Registry:Alive(context.Owner) or context.Owner.MagicEpoch ~= context.Epoch then return nil end
	local now, spell = workspace:GetServerTimeNow(), context.Spell
	local field = { Owner = context.Owner, Epoch = context.Epoch, Spell = spell, Context = context, Kind = kind,
		Point = position, Until = now + spell.Duration, Activation = now + (spell.Delay or .15), NextTick = now,
		Pulse = 0, Phase = 0, Bound = {}, Seen = {}, ChannelGeneration = context.CastGeneration }
	for key, value in options or {} do field[key] = value end
	field.Root = World:Create(field.Owner, spell, kind, position, field.Until - now)
	field.Root:SetAttribute("Activation", field.Activation)
	self.Items[field.Root] = field
	self.Count += 1
	return field
end
function Fields:Remove(field, completed)
	if not self.Items[field.Root] then return end
	self.Items[field.Root] = nil
	self.Count -= 1
	local spell, now = field.Spell, workspace:GetServerTimeNow()
	if completed and spell.FinalDamage and Registry:Alive(field.Owner) then
		local final = table.clone(spell)
		final.Damage, final.Knockback, final.Stun = spell.FinalDamage, 30, .35
		for _, target in Hitbox:Area(field.Owner, field.Point, spell.Radius, false) do Damage:Spell(field.Owner, target, final, now, self.FX) end
		World:Pulse("Final", field.Point, spell.ElementType, spell.Radius, spell.Visual)
	end
	if completed and field.Kind == "Tornado" then
		for _, target in Hitbox:Area(field.Owner, field.Point, spell.Radius, false) do
			if not target.Root.Anchored then target.Root:ApplyImpulse(Vector3.new(0, 23, 0) * target.Root.AssemblyMass) end
		end
	end
	for target in field.Bound do
		if target.RootSource == field then target.RootedUntil, target.GrabPosition, target.RootSource = 0, nil, nil end
	end
	field.Root:Destroy()
end
function Fields:Bind(field, target, now, grab)
	if now < (target.RootResistUntil or 0) then return end
	if not Status:Root(target, field.Spell.RootTime, now) then return end
	target.RootSource = field
	target.RootResistUntil = now + field.Spell.RootTime + 1
	field.Bound[target] = true
	if grab and not target.Root.Anchored then
		target.GrabPosition = field.Point + Vector3.new(0, 9, 0)
		target.GrabUntil = now + field.Spell.RootTime
	end
end
function Fields:Tick(field, now)
	local spell, source = field.Spell, field.Owner
	field.Pulse += 1
	local point = field.Point
	if field.Kind == "Prison" then
		if field.Phase ~= 0 then return end
		field.Phase = 1
		for _, target in Hitbox:Area(source, point, spell.Radius, false) do
			Damage:Spell(source, target, spell, now, self.FX)
			self:Bind(field, target, now, false)
		end
	elseif field.Kind == "Hand" then
		if field.Phase == 0 then
			field.Phase = 1
			field.SlamAt = now + 1.05
			field.NextTick = field.SlamAt
			for _, target in Hitbox:Area(source, point, spell.Radius, false) do self:Bind(field, target, now, true) end
		elseif field.Phase == 1 and now >= field.SlamAt then
			field.Phase = 2
			for target in field.Bound do
				if not Registry:Alive(target) then continue end
				if target.RootSource == field then
					target.GrabPosition, target.RootedUntil = nil, 0
					local ground = Hitbox:Ground(target.Root.Position, target)
					if ground and not target.Root.Anchored then target.Root.CFrame = CFrame.new(ground + Vector3.new(0, 3, 0)) * target.Root.CFrame.Rotation end
				end
				Damage:Spell(source, target, spell, now, self.FX)
			end
			World:Pulse("Final", point, "Bone", spell.Radius, "BoneHand")
		end
	elseif field.Kind == "Judgment" then
		-- The summoned spear projectiles do the damage; final damage is resolved on expiry.
	elseif field.Kind == "Spike" then
		if field.Phase ~= 0 then return end
		field.Phase = 1
		field.Context.Hits = field.Context.Hits or {}
		for _, target in Hitbox:Area(source, point + Vector3.new(0, 2, 0), spell.Radius, false) do
			if now - (field.Context.Hits[target] or -math.huge) >= .22 then
				field.Context.Hits[target] = now
				Damage:Spell(source, target, spell, now, self.FX)
			end
		end
	else
		local radius = spell.Radius
		if field.Kind == "Domain" and spell.PulseRadius then
			local nearest = Hitbox:Nearest(source, point + Vector3.new(0, 3, 0), spell.Radius)
			if nearest then point = nearest.Root.Position end
			radius = spell.PulseRadius
		end
		for _, target in Hitbox:Area(source, point, radius, false) do
			Damage:Spell(source, target, spell, now, self.FX)
			if field.Kind == "Tornado" and not target.Root.Anchored then
				local delta = field.Point - target.Root.Position
				local horizontal = Vector3.new(delta.X, 0, delta.Z)
				if horizontal.Magnitude > .2 then
					local impulse = horizontal.Unit * spell.Pull + Vector3.new(0, 9, 0)
					target.Root:ApplyImpulse(impulse * target.Root.AssemblyMass)
					target.MotionGrace = now + .6
				end
			end
		end
		if spell.ElementType == "Ice" and field.Kind == "Domain" then
			for _, target in Hitbox:Area(source, field.Point, spell.Radius, false) do Passive:AfterHit(source, target, 0, "Ice", now) end
		end
		if spell.Cut then Projectiles:Cut(source, spell.ClashPower, spell.Radius) end
	end
	field.Root:SetAttribute("Phase", field.Phase)
	field.Root:SetAttribute("PulsePosition", point)
	field.Root:SetAttribute("PulseTime", now)
	field.Root:SetAttribute("Pulse", field.Pulse)
end
function Fields:Step(dt, now)
	for _, field in self.Items do
		local source, spell = field.Owner, field.Spell
		if not Registry:Alive(source) or source.MagicEpoch ~= field.Epoch
			or (spell.Channel > 0 and source.CastGeneration ~= field.ChannelGeneration) then self:Remove(field, false); continue end
		if now >= field.Until then self:Remove(field, true); continue end
		if field.Kind == "Spin" then
			field.Point = source.Root.Position
			field.Root.CFrame = source.Root.CFrame
		elseif field.Kind == "Tornado" then
			local delta = field.Context.Point - field.Point
			local horizontal = Vector3.new(delta.X, 0, delta.Z)
			if horizontal.Magnitude > 1 then field.Point += horizontal.Unit * math.min(horizontal.Magnitude, spell.Speed * dt) end
			field.Root.CFrame = CFrame.new(field.Point)
			Projectiles:Deflect(source, field.Point, spell.Radius, now)
		end
		if now >= field.Activation and now >= field.NextTick then
			field.NextTick = now + spell.Tick
			self:Tick(field, now)
		end
	end
end
function Fields:RemoveOwner(owner)
	for _, field in self.Items do if field.Owner == owner then self:Remove(field, false) end end
	for context in self.Reservations do if context.Owner == owner then self:Release(context) end end
end
return Fields
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="865">
        <Properties>
          <string name="Name">Hitbox</string>
          <string name="Source"><![CDATA[--!nonstrict
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Config)
local Registry = require(script.Parent.Registry)
local Targeting = require(script.Parent.MagicHitboxService)
local Hitbox = {}

function Hitbox:Find(source, requestedReach)
	local reach = requestedReach or Config.Combat.Reach
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { source.Model }
	params.MaxParts = 0 -- no cap that could hide a nearby target among cosmetic parts
	local box = source.Root.CFrame * CFrame.new(0, 0, -(reach - 1) / 2)
	local parts = workspace:GetPartBoundsInBox(box, Vector3.new(Config.Combat.Width, Config.Combat.Height, reach - 1), params)
	local seen, results = {}, {}
	local ray = RaycastParams.new()
	ray.FilterType = Enum.RaycastFilterType.Exclude
	ray.FilterDescendantsInstances = { source.Model }
	for _, part in parts do
		local target = Registry:FromPart(part)
		if not target or target == source or seen[target] or not Registry:Alive(target) then continue end
		seen[target] = true
		if not Targeting:CanHit(source, target) then continue end
		local delta = target.Root.Position - source.Root.Position
		if delta.Magnitude > reach or delta.Magnitude < 0.01 then continue end
		if source.Root.CFrame.LookVector:Dot(delta.Unit) < 0.2 then continue end
		local obstruction = workspace:Raycast(source.Root.Position, delta, ray)
		if obstruction and not obstruction.Instance:IsDescendantOf(target.Model) then continue end
		table.insert(results, target)
	end
	return results
end

return Hitbox
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="866">
        <Properties>
          <string name="Name">MagicHitboxService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Registry = require(script.Parent.Registry)
local Rules = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Rules)
local Hitbox = {}
function Hitbox:CanHit(source, target)
	if source == target or not Registry:Alive(source) or not Registry:Alive(target) then return false end
	local owner = source.Owner or source
	if target == owner or target.Owner == owner or source.Owner == target then return false end
	if source.Kind == "Enemy" then return target.Kind == "Player" or target.Kind == "Golem" end
	return true
end
function Hitbox:WorldParams(source)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignored = {}
	for model in Registry.Actors do table.insert(ignored, model) end
	if source and not table.find(ignored, source.Model) then table.insert(ignored, source.Model) end
	params.FilterDescendantsInstances = ignored
	params.RespectCanCollide = true
	return params
end
function Hitbox:PointIsValid(point)
	return typeof(point) == "Vector3" and Rules.finite(point.X) and Rules.finite(point.Y) and Rules.finite(point.Z)
		and math.abs(point.X) < 100000 and math.abs(point.Y) < 100000 and math.abs(point.Z) < 100000
end
function Hitbox:ResolveAim(source, point, range)
	if not self:PointIsValid(point) then return nil end
	local delta = point - source.Root.Position
	if delta.Magnitude < .1 then delta = source.Root.CFrame.LookVector end
	return source.Root.Position + delta.Unit * math.min(delta.Magnitude, range)
end
function Hitbox:Ground(point, source)
	local result = workspace:Raycast(point + Vector3.new(0, 65, 0), Vector3.new(0, -180, 0), self:WorldParams(source))
	return result and result.Position or nil
end
function Hitbox:Visible(source, position, target)
	local params = self:WorldParams(source)
	local delta = position - source.Root.Position
	if delta.Magnitude < .01 then return true end
	local hit = workspace:Raycast(source.Root.Position, delta, params)
	return not hit or (target and hit.Instance:IsDescendantOf(target.Model))
end
function Hitbox:Area(source, center, radius, visibility)
	local found = {}
	for _, target in Registry.Actors do
		if self:CanHit(source, target) and (target.Root.Position - center).Magnitude <= radius + math.max(1.5, target.Root.Size.X * .7) then
			if not visibility or self:Visible(source, target.Root.Position, target) then table.insert(found, target) end
		end
	end
	return found
end
function Hitbox:Nearest(source, point, radius)
	local best, distance = nil, radius
	for _, target in self:Area(source, point, radius, true) do
		local d = (target.Root.Position - point).Magnitude
		if d < distance then best, distance = target, d end
	end
	return best
end
function Hitbox:Segment(source, a, b, radius)
	local result, delta = {}, b - a
	local length2 = delta:Dot(delta)
	for _, target in Registry.Actors do
		if not self:CanHit(source, target) then continue end
		local t = length2 > .001 and math.clamp((target.Root.Position - a):Dot(delta) / length2, 0, 1) or 0
		if (target.Root.Position - (a + delta * t)).Magnitude <= radius + math.max(1.2, target.Root.Size.X * .6) then table.insert(result, { State = target, Time = t }) end
	end
	table.sort(result, function(x, y) return x.Time < y.Time end)
	return result
end
return Hitbox
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="867">
        <Properties>
          <string name="Name">MagicManager</string>
          <string name="Source"><![CDATA[--!nonstrict
local shared = game:GetService("ReplicatedStorage").BlackClover.Shared
local Config, Spells = require(shared.MagicConfig), require(shared.SpellRegistry)
local Rules = require(shared.MagicRules)
local Registry = require(script.Parent.Registry)
local Mana = require(script.Parent.ManaManager)
local Hitbox = require(script.Parent.MagicHitboxService)
local Executor = require(script.Parent.SpellExecutor)
local Awakening = require(script.Parent.AwakeningManager)
local Projectiles = require(script.Parent.ProjectileService)
local Fields = require(script.Parent.FieldService)
local Constructs = require(script.Parent.ConstructService)
local Summons = require(script.Parent.SummonService)
local Motion = require(script.Parent.MagicMotionService)
local Status = require(script.Parent.StatusService)
local World = require(script.Parent.MagicWorld)
local Manager = { Profiles = {}, Serial = 0, Pending = {} }
function Manager:Cancel(state)
	state.MagicEpoch += 1
	state.CastGeneration += 1
	state.Generation += 1
	local pending = self.Pending[state]
	if pending then Executor:Release(pending); self.Pending[state] = nil end
	Projectiles:RemoveOwner(state)
	Fields:RemoveOwner(state)
	Constructs:RemoveOwner(state)
	Summons:Remove(state)
	Motion:RemoveOwner(state)
	state.Shield, state.ParryUntil = nil, 0
	state.Model:SetAttribute("ShieldVisual", "")
	state.Model:SetAttribute("CastSpell", "")
	state.Model:SetAttribute("WeaponOverride", "")
	state.Model:SetAttribute("ParryUntil", 0)
end
function Manager:Initialize(state)
	local saved = state.Player and self.Profiles[state.Player]
	if saved then self:Select(state, saved, workspace:GetServerTimeNow(), true) end
end
function Manager:Select(state, id, now, restoring)
	if type(id) ~= "string" or not Config.Classes[id] or (not restoring and now < state.SelectReady) then return false end
	Awakening:Stop(state, now)
	self:Cancel(state)
	state.MagicId, state.SelectReady = id, now + Config.SelectCooldown
	state.BusyUntil = math.max(now, state.AttackReady)
	state.Blocking = false
	state.Model:SetAttribute("MagicId", id)
	state.Model:SetAttribute("MagicName", Config.Classes[id].Name)
	state.Model:SetAttribute("MeleeProfile", id == "Anti" and "Sword" or "Fist")
	if state.Player then self.Profiles[state.Player] = id end
	Registry:Publish(state)
	return true
end
function Manager:Cast(state, input, now)
	if type(input) ~= "table" or type(input.Slot) ~= "string" or #input.Slot ~= 1 then return false end
	local spell = Spells.Get(state.MagicId, state.Awakened, input.Slot)
	if not spell or now < state.StunUntil or now < state.RootedUntil or now < state.SuppressedUntil or now < state.BusyUntil or state.Blocking then return false end
	if spell.Kind == "Summon" and Summons.Items[state] then Summons:Remove(state); return true end
	if now < (state.Cooldowns[spell.Id] or 0) or state.Mana < spell.ManaCost then return false end
	local point = Hitbox:ResolveAim(state, input.Point, spell.Range)
	if not point then return false end
	local delta = point - state.Root.Position
	local direction = delta.Magnitude > .1 and delta.Unit or state.Root.CFrame.LookVector
	self.Serial += 1
	local context = { Owner = state, Spell = spell, Point = point, Direction = direction, Epoch = state.MagicEpoch,
		Serial = self.Serial, Now = now, CastGeneration = state.CastGeneration + 1 }
	if not Executor:Reserve(context) then return false end
	if not Mana:Spend(state, spell.ManaCost, now) then Executor:Release(context); return false end
	state.CastGeneration = context.CastGeneration
	state.Generation += 1
	state.BusyUntil = now + spell.CastTime + spell.Channel + spell.Recovery
	state.Cooldowns[spell.Id] = now + Rules.cooldown(spell.Cooldown, spell.ElementType, spell.Kind)
	state.Model:SetAttribute("CD_" .. spell.Id, state.Cooldowns[spell.Id])
	state.Model:SetAttribute("CastStart", now)
	state.Model:SetAttribute("CastRelease", now + spell.CastTime)
	state.Model:SetAttribute("CastEnd", state.BusyUntil)
	state.Model:SetAttribute("CastAim", point)
	state.Model:SetAttribute("CastSpell", spell.Id)
	if spell.Weapon then state.Model:SetAttribute("WeaponOverride", spell.Weapon); state.Model:SetAttribute("WeaponUntil", state.BusyUntil + spell.Duration + .4) end
	self.Pending[state] = context
	Registry:Publish(state)
	task.delay(spell.CastTime, function()
		if self.Pending[state] == context then self.Pending[state] = nil end
		if not Registry:Alive(state) or state.CastGeneration ~= context.CastGeneration or state.MagicEpoch ~= context.Epoch
			or workspace:GetServerTimeNow() < state.StunUntil or workspace:GetServerTimeNow() < state.RootedUntil
			or (spell.Awakened and not state.Awakened) then Executor:Release(context); return end
		if not Executor:Execute(context) then
			Executor:Release(context)
			state.Mana = math.min(state.MaxMana, state.Mana + spell.ManaCost)
			state.Cooldowns[spell.Id] = 0
			state.Model:SetAttribute("CD_" .. spell.Id, 0)
			state.Model:SetAttribute("CastSpell", "")
			state.BusyUntil = workspace:GetServerTimeNow()
			if state.Player then self.Remote:FireClient(state.Player, "Notice", "Здесь нельзя применить эту способность") end
		else
			state.ReleasedSerial = context.Serial
		end
	end)
	return true
end
function Manager:Request(state, action, input, now)
	if action == "SelectMagic" then return self:Select(state, input, now)
	elseif action == "Cast" then return self:Cast(state, input, now)
	elseif action == "Awakening" and input == nil then return Awakening:Toggle(state, now)
	elseif action == "Flight" then return Motion:Flight(state, input, now)
	end
	return false
end
function Manager:Start(fx, remote)
	self.Remote = remote
	World:Init(remote)
	Projectiles.FX, Fields.FX, Summons.FX, Motion.FX = fx, fx, fx, fx
	Awakening.Cancel = function(state) self:Cancel(state) end
	Registry.OnRemoving = function(state) self:Cancel(state) end
	require(script.Parent.CombatSystem).MagicHook = function(state, definition, seen)
		if state.MagicId == "Anti" then Projectiles:Cut(state, state.Awakened and 52 or 28, 9) end
		Constructs:Melee(state, definition.Damage, seen)
	end
end
function Manager:Death(state)
	Awakening:Stop(state, workspace:GetServerTimeNow())
	self:Cancel(state)
	state.Awakened = false
	state.Model:SetAttribute("Awakened", false)
end
function Manager:Step(dt, now)
	Awakening:Step(now)
	for _, state in Registry.Actors do
		if now < state.SuppressedUntil and state.LastSuppression ~= state.SuppressedUntil then
			state.LastSuppression = state.SuppressedUntil
			self:Cancel(state)
		end
		if (state.Model:GetAttribute("CastEnd") or 0) <= now and state.Model:GetAttribute("CastSpell") ~= "" then state.Model:SetAttribute("CastSpell", "") end
	end
	Status:Step(now)
	Motion:Step(dt, now)
	Projectiles:Step(dt, now)
	Fields:Step(dt, now)
	Constructs:Step(now)
	self.AITime = (self.AITime or 0) + dt
	if self.AITime >= .1 then self.AITime = 0; Summons:Step(now) end
end
return Manager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="868">
        <Properties>
          <string name="Name">MagicMotionService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicConfig)
local Registry = require(script.Parent.Registry)
local Hitbox = require(script.Parent.MagicHitboxService)
local Movement = require(script.Parent.MovementSystem)
local Damage = require(script.Parent.DamageService)
local Projectiles = require(script.Parent.ProjectileService)
local World = require(script.Parent.MagicWorld)
local Motion = { Dashes = {} }
local function constraint(state, velocity, aerial, name)
	local attachment = Instance.new("Attachment")
	attachment.Name, attachment.Parent = name .. "Attachment", state.Root
	local mover = Instance.new("LinearVelocity")
	mover.Name, mover.Attachment0 = name, attachment
	mover.RelativeTo = Enum.ActuatorRelativeTo.World
	mover.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	mover.ForceLimitsEnabled, mover.ForceLimitMode = true, Enum.ForceLimitMode.PerAxis
	mover.MaxAxesForce = Vector3.new(100000, aerial and 100000 or 0, 100000)
	mover.VectorVelocity, mover.Parent = velocity, state.Root
	state.Root:SetNetworkOwner(nil)
	return mover, attachment
end
function Motion:Dash(context)
	local source, spell, now = context.Owner, context.Spell, workspace:GetServerTimeNow()
	local direction = context.Direction
	if not spell.Aerial then direction = Vector3.new(direction.X, 0, direction.Z) end
	if direction.Magnitude < .01 then direction = source.Root.CFrame.LookVector end
	direction = direction.Unit
	self:StopFlight(source)
	Movement:StopDash(source)
	source.DashDirection, source.DashSpeed = direction, spell.Speed
	source.DashUntil, source.MotionGrace = now + spell.Duration, now + spell.Duration + .5
	source.BusyUntil = math.max(source.BusyUntil, source.DashUntil)
	source.DashConstraint, source.DashAttachment = constraint(source, direction * spell.Speed, spell.Aerial, "MagicDash")
	source.Model:SetAttribute("DashUntil", source.DashUntil)
	self.Dashes[source] = { Context = context, Until = source.DashUntil, Previous = source.Root.Position, Seen = {} }
	return true
end
function Motion:Teleport(context)
	local source = context.Owner
	local ground = Hitbox:Ground(context.Point, source)
	if not ground then return false end
	local elevation = source.Humanoid.HipHeight + source.Root.Size.Y / 2
	local destination = ground + Vector3.new(0, elevation, 0)
	local delta = destination - source.Root.Position
	if delta.Magnitude > context.Spell.Range + 1 or delta.Magnitude < 2 then return false end
	local block = workspace:Blockcast(source.Root.CFrame, Vector3.new(2.2, 4.8, 2.2), delta, Hitbox:WorldParams(source))
	if block then destination = source.Root.Position + delta.Unit * math.max(0, block.Distance - 1.2) end
	if (destination - source.Root.Position).Magnitude < 2 then return false end
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = Hitbox:WorldParams(source).FilterDescendantsInstances
	params.RespectCanCollide = true
	for _, part in workspace:GetPartBoundsInBox(CFrame.new(destination), Vector3.new(2, 4.6, 2), params) do
		if part.CanCollide then return false end
	end
	World:Pulse("Teleport", source.Root.Position, "Stars", 6)
	source.Root.CFrame = CFrame.new(destination) * source.Root.CFrame.Rotation
	source.Root.AssemblyLinearVelocity = Vector3.zero
	source.LastPosition, source.LastCFrame = destination, source.Root.CFrame
	source.MotionGrace = workspace:GetServerTimeNow() + .7
	World:Pulse("Teleport", destination, "Stars", 6)
	return true
end
function Motion:StopFlight(state)
	if state.FlightConstraint then state.FlightConstraint:Destroy(); state.FlightConstraint = nil end
	if state.FlightAttachment then state.FlightAttachment:Destroy(); state.FlightAttachment = nil end
	state.FlightUntil = 0
	state.Model:SetAttribute("FlightUntil", 0)
	if Registry:Alive(state) and state.Player and not state.Root.Anchored and not state.DashDirection and not state.ControlOwned then state.Root:SetNetworkOwnershipAuto() end
end
function Motion:Flight(state, input, now)
	if type(input) ~= "table" or type(input.Active) ~= "boolean" then return false end
	if not input.Active then self:StopFlight(state); return true end
	if not Hitbox:PointIsValid(input.Direction) or input.Direction.Magnitude > 1.1 then return false end
	if not state.Awakened or (state.MagicId ~= "Wind" and state.MagicId ~= "Anti") or now < state.StunUntil
		or now < state.RootedUntil or state.DashDirection then return false end
	if not state.FlightConstraint then
		if now < state.FlightReady or now < state.BusyUntil then return false end
		state.FlightUntil, state.FlightReady = now + Config.Flight.Duration, now + Config.Flight.Cooldown
		state.FlightConstraint, state.FlightAttachment = constraint(state, Vector3.zero, true, "AwakeningFlight")
		state.Model:SetAttribute("FlightUntil", state.FlightUntil)
		state.Model:SetAttribute("FlightReady", state.FlightReady)
	end
	state.FlightInput, state.FlightLastInput = input.Direction, now
	return true
end
function Motion:Step(dt, now)
	for source, dash in self.Dashes do
		local context = dash.Context
		if not Registry:Alive(source) or source.MagicEpoch ~= context.Epoch then self.Dashes[source] = nil; Movement:StopDash(source); continue end
		for _, entry in Hitbox:Segment(source, dash.Previous, source.Root.Position, context.Spell.Radius) do
			if not dash.Seen[entry.State] then dash.Seen[entry.State] = true; Damage:Spell(source, entry.State, context.Spell, now, self.FX) end
		end
		if context.Spell.Cut then Projectiles:Cut(source, context.Spell.ClashPower, context.Spell.Radius + 3) end
		dash.Previous = source.Root.Position
		if now >= dash.Until or now < source.StunUntil or not source.DashDirection then self.Dashes[source] = nil; Movement:StopDash(source) end
	end
	for _, state in Registry.Actors do
		if not state.FlightConstraint then continue end
		if not Registry:Alive(state) or not state.Awakened or now >= state.FlightUntil
			or now - (state.FlightLastInput or 0) > Config.Flight.InputTimeout or now < state.StunUntil or now < state.RootedUntil then
			self:StopFlight(state); continue
		end
		local desired = (state.FlightInput or Vector3.zero) * Config.Flight.Speed
		if desired.Magnitude > .1 then
			local hit = workspace:Blockcast(state.Root.CFrame, Vector3.new(2.3, 4.8, 2.3), desired * math.min(dt + .04, .15), Hitbox:WorldParams(state))
			if hit then desired = Vector3.zero end
		end
		state.FlightConstraint.VectorVelocity = desired
		state.MotionGrace = now + .35
	end
end
function Motion:RemoveOwner(owner)
	self.Dashes[owner] = nil
	Movement:StopDash(owner)
	self:StopFlight(owner)
end
return Motion
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="869">
        <Properties>
          <string name="Name">MagicWorld</string>
          <string name="Source"><![CDATA[--!nonstrict
local CollectionService = game:GetService("CollectionService")
local World = { Serial = 0 }
function World:Init(remote)
	self.Remote = remote
	self.Folder = Instance.new("Folder")
	self.Folder.Name, self.Folder.Parent = "MagicWorld", workspace
end
function World:Create(owner, spell, kind, position, duration)
	self.Serial += 1
	local root = Instance.new("Part")
	root.Name = kind .. "_" .. self.Serial
	root.Size, root.Transparency = Vector3.one * .2, 1
	root.Anchored, root.CanCollide, root.CanTouch, root.CanQuery = true, false, false, false
	root.CFrame = CFrame.new(position)
	root:SetAttribute("EntityId", self.Serial)
	root:SetAttribute("EntityKind", kind)
	root:SetAttribute("SpellId", spell.Id)
	root:SetAttribute("Visual", spell.Visual)
	root:SetAttribute("Element", spell.ElementType)
	root:SetAttribute("Radius", spell.Radius)
	root:SetAttribute("StartTime", workspace:GetServerTimeNow())
	root:SetAttribute("EndTime", workspace:GetServerTimeNow() + duration)
	local reference = Instance.new("ObjectValue")
	reference.Name, reference.Value, reference.Parent = "Owner", owner.Model, root
	root.Parent = self.Folder
	CollectionService:AddTag(root, "BCSpellEntity")
	return root
end
function World:Pulse(kind, position, element, radius, detail)
	if self.Remote then self.Remote:FireAllClients(kind, position, element, radius, detail) end
end
return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="870">
        <Properties>
          <string name="Name">ManaManager</string>
          <string name="Source"><![CDATA[--!nonstrict
local shared = game:GetService("ReplicatedStorage").BlackClover.Shared
local Config = require(shared.Config)
local MagicConfig = require(shared.MagicConfig)
local Rules = require(shared.Rules)
local MagicRules = require(shared.MagicRules)
local Mana = {}
function Mana:Spend(state, cost, now)
	local ok, value = Rules.spend(state.Mana, cost)
	if ok then state.Mana, state.LastManaUse = value, now end
	return ok
end
function Mana:Step(state, dt, now)
	state.MaxMana = Rules.maxMana(Config.Player.Mana, Config.Player.ManaPerLevel, state.Level)
	local class = MagicConfig.Classes[state.MagicId]
	if state.Awakened and class then
		state.Mana = MagicRules.manaAfter(state.Mana, state.MaxMana, dt, true, class.Drain, 0)
		state.LastManaUse = now
	else
		local eligible = math.min(dt, math.max(0, now - state.LastManaUse - Config.Player.ManaRegenDelay))
		state.Mana = MagicRules.manaAfter(state.Mana, state.MaxMana, eligible, false, 0, Config.Player.ManaRegen)
	end
end
return Mana
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="871">
        <Properties>
          <string name="Name">MovementSystem</string>
          <string name="Source"><![CDATA[--!nonstrict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.BlackClover.Shared.Config)
local Rules = require(ReplicatedStorage.BlackClover.Shared.Rules)
local Registry = require(script.Parent.Registry)
local Mana = require(script.Parent.ManaManager)
local Passive = require(script.Parent.PassiveService)
local MagicConfig = require(ReplicatedStorage.BlackClover.Shared.MagicConfig)
local Movement = {}

function Movement:StopDash(state)
	if state.DashConstraint then state.DashConstraint:Destroy(); state.DashConstraint = nil end
	if state.DashAttachment then state.DashAttachment:Destroy(); state.DashAttachment = nil end
	if state.DashDirection then
		state.DashDirection = nil
		state.DashUntil = 0
		state.Model:SetAttribute("DashUntil", 0)
		if state.Root.Parent and not state.Root.Anchored then
			local velocity = state.Root.AssemblyLinearVelocity
			state.Root.AssemblyLinearVelocity = Vector3.new(0, velocity.Y, 0)
			if state.Player and not state.FlightConstraint and not state.ControlOwned then state.Root:SetNetworkOwnershipAuto() end
		end
	end
end

function Movement:ValidateMotion(state, now)
	if not state.Player or not Registry:Alive(state) then return true end
	local elapsed = now - state.LastMotion
	if elapsed < 0.08 then return true end
	local delta = state.Root.Position - state.LastPosition
	local horizontal = Vector3.new(delta.X, 0, delta.Z).Magnitude
	local allowance = Config.Movement.Sprint * Passive:Speed(state, now) * elapsed + 5
	local valid = now <= state.MotionGrace or horizontal <= allowance
	if not valid then
		state.Root.CFrame = state.LastCFrame
		state.Root.AssemblyLinearVelocity = Vector3.zero
		state.StunUntil = math.max(state.StunUntil, now + 0.25)
	end
	state.LastPosition = state.Root.Position
	state.LastCFrame = state.Root.CFrame
	state.LastMotion = now
	return valid
end

function Movement:Dash(state, requested, now, fx)
	if not Registry:Alive(state) or not Rules.canAct(state.Humanoid.Health, now, state.BusyUntil, state.StunUntil)
		or state.Blocking or now < state.DashReady or now < state.RootedUntil or state.FlightConstraint then return false end
	if typeof(requested) ~= "Vector3" or not Rules.finite(requested.X) or not Rules.finite(requested.Y)
		or not Rules.finite(requested.Z) or requested.Magnitude > 2 then return false end
	local airborne = state.Humanoid.FloorMaterial == Enum.Material.Air
	if airborne and (state.MagicId ~= "Wind" or state.AirDashes >= 1) then return false end
	local direction = Vector3.new(requested.X, 0, requested.Z)
	if direction.Magnitude < 0.1 then
		local look = state.Root.CFrame.LookVector
		direction = Vector3.new(look.X, 0, look.Z)
	end
	if direction.Magnitude < 0.01 then return false end
	direction = direction.Unit
	if not Mana:Spend(state, Config.Movement.DashMana, now) then return false end
	if airborne then state.AirDashes += 1 end
	local dashSpeed = Config.Movement.DashSpeed * (airborne and MagicConfig.Passives.WindAirDash or 1)
	state.DashUntil = now + Config.Movement.DashDuration
	state.DashReady = now + Config.Movement.DashCooldown
	state.BusyUntil = state.DashUntil
	state.MotionGrace = state.DashUntil + 0.35
	state.DashDirection = direction
	state.Root:SetNetworkOwner(nil)
	local attachment = Instance.new("Attachment")
	attachment.Name = "DashAttachment"
	attachment.Parent = state.Root
	local velocity = Instance.new("LinearVelocity")
	velocity.Name = "DashVelocity"
	velocity.Attachment0 = attachment
	velocity.RelativeTo = Enum.ActuatorRelativeTo.World
	velocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	velocity.VectorVelocity = direction * dashSpeed
	state.DashSpeed = dashSpeed
	velocity.ForceLimitsEnabled = true
	velocity.ForceLimitMode = Enum.ForceLimitMode.PerAxis
	velocity.MaxAxesForce = Vector3.new(80000, 0, 80000)
	velocity.Parent = state.Root
	state.DashAttachment = attachment
	state.DashConstraint = velocity
	state.Model:SetAttribute("DashUntil", state.DashUntil)
	Registry:Publish(state)
	fx:FireAllClients("Dash", state.Model, state.Root.Position)
	return true
end

function Movement:Step(dt, now)
	for _, state in Registry.Actors do
		if not Registry:Alive(state) then self:StopDash(state); continue end
		self:ValidateMotion(state, now)
		local stunned = now < state.StunUntil or now < state.RootedUntil
		if state.Humanoid.FloorMaterial ~= Enum.Material.Air then state.AirDashes = 0 end
		if state.DashDirection then
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.FilterDescendantsInstances = { state.Model }
			params.RespectCanCollide = true
			local travel = state.DashDirection * ((state.DashSpeed or Config.Movement.DashSpeed) * math.min(dt, 0.1) + 2)
			local hit = workspace:Blockcast(state.Root.CFrame, Vector3.new(1.8, 2.8, 1.8), travel, params)
			if now >= state.DashUntil or stunned or hit then self:StopDash(state) end
		end
		local speed = state.BaseSpeed or Config.Movement.Walk
		if state.Kind == "Dummy" then speed = 0
		elseif stunned or state.DashDirection or state.FlightConstraint then speed = 0
		elseif state.Blocking then speed = Config.Movement.Block
		elseif now < state.BusyUntil then speed = 9
		elseif state.Sprinting then speed = Config.Movement.Sprint end
		state.Humanoid.WalkSpeed = speed * Passive:Speed(state, now)
		state.Humanoid.JumpPower = (stunned or state.Blocking or now < state.BusyUntil) and 0 or Config.Movement.Jump
		state.Humanoid.AutoRotate = not state.DashDirection and not stunned
		if stunned then state.Blocking = false end
	end
end

return Movement
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="872">
        <Properties>
          <string name="Name">PassiveService</string>
          <string name="Source"><![CDATA[--!nonstrict
local P = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicConfig).Passives
local Passive = {}
function Passive:Damage(target, damage, magical)
	if target.MagicId == "Water" then damage *= P.WaterDefense end
	if target.MagicId == "Earth" then damage *= P.EarthDefense end
	if magical and target.MagicId == "Anti" then damage *= P.AntiDefense end
	return damage
end
function Passive:Speed(state, now)
	local multiplier = state.MagicId == "Wind" and P.WindSpeed or 1
	if now < (state.SlowUntil or 0) then multiplier *= 1 - math.min(P.IceStacks, state.SlowStacks or 0) * P.IceSlowPerStack end
	return multiplier
end
function Passive:AfterHit(source, target, damage, element, now)
	if element == "Ice" then
		if now >= target.SlowUntil then target.SlowStacks = 0 end
		target.SlowStacks = math.min(P.IceStacks, target.SlowStacks + 1)
		target.SlowUntil = now + P.IceDuration
		if target.SlowStacks == P.IceStacks and now >= (target.FreezeReady or 0) then
			target.RootedUntil = math.max(target.RootedUntil, now + .6)
			target.RootAnchor = target.Root.Position
			target.CastGeneration += 1
			target.Generation += 1
			target.Model:SetAttribute("CastSpell", "")
			target.Model:SetAttribute("AttackStart", 0)
			target.FreezeReady = now + 4
		end
	end
	if element == "Bone" and source.MagicId == "Bone" and damage > 0 then
		if now - (source.LeechWindow or 0) >= 1 then source.LeechWindow, source.LeechUsed = now, 0 end
		local heal = math.min(damage * P.BoneLeech, P.BoneHealPerSecond - (source.LeechUsed or 0))
		source.LeechUsed = (source.LeechUsed or 0) + heal
		source.Humanoid.Health = math.min(source.Humanoid.MaxHealth, source.Humanoid.Health + heal)
	end
end
function Passive:Knockback(state)
	return state.MagicId == "Earth" and P.EarthKnockback or 1
end
return Passive
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="873">
        <Properties>
          <string name="Name">ProjectileService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicConfig)
local Registry = require(script.Parent.Registry)
local Hitbox = require(script.Parent.MagicHitboxService)
local Damage = require(script.Parent.DamageService)
local World = require(script.Parent.MagicWorld)
local Constructs = require(script.Parent.ConstructService)
local Clash = require(script.Parent.ClashManager)
local Projectiles = { Items = {}, Reservations = {}, Count = 0, Reserved = 0 }
function Projectiles:Reserve(context, count)
	local own = 0
	for _, p in self.Items do if p.Owner == context.Owner then own += 1 end end
	for ctx, n in self.Reservations do if ctx.Owner == context.Owner then own += n end end
	if self.Count + self.Reserved + count > Config.Limits.Projectiles or own + count > Config.Limits.ProjectilesPerOwner then return false end
	self.Reservations[context] = count
	self.Reserved += count
	return true
end
function Projectiles:Release(context)
	local n = self.Reservations[context] or 0
	self.Reserved -= n
	self.Reservations[context] = nil
end
function Projectiles:Create(context, origin, direction, overrides)
	local reserved = self.Reservations[context] or 0
	if reserved <= 0 then return nil end
	self.Reservations[context] = reserved - 1
	self.Reserved -= 1
	if reserved == 1 then self.Reservations[context] = nil end
	if not Registry:Alive(context.Owner) or context.Owner.MagicEpoch ~= context.Epoch then return nil end
	local spell = context.Spell
	local p = { Owner = context.Owner, Epoch = context.Epoch, Spell = spell, Position = origin, Previous = origin, Next = origin,
		Direction = direction.Unit, Speed = spell.Speed, Radius = spell.Radius, Power = spell.ClashPower, Element = spell.ElementType,
		Range = spell.Range, Traveled = 0, Multiplier = 1, Seen = {}, Born = workspace:GetServerTimeNow(), Reflections = 0,
		Target = spell.Homing and Hitbox:Nearest(context.Owner, context.Point, 22) or nil }
	for key, value in overrides or {} do p[key] = value end
	p.Root = World:Create(p.Owner, spell, "Projectile", origin, p.Range / p.Speed + 2)
	p.Root:SetAttribute("Radius", p.Radius)
	p.Root.CFrame = CFrame.lookAt(origin, origin + p.Direction)
	self.Items[p.Root] = p
	self.Count += 1
	return p
end
function Projectiles:Remove(p)
	if p.Removed then return end
	p.Removed = true
	self.Items[p.Root] = nil
	self.Count -= 1
	p.Root:Destroy()
end
function Projectiles:Impact(p, position, now)
	World:Pulse("Impact", position, p.Element, p.Spell.Explosion or p.Radius * 2, p.Spell.Visual)
	if p.Spell.Explosion then
		for _, target in Hitbox:Area(p.Owner, position, p.Spell.Explosion, false) do
			if not p.Seen[target] then
				p.Seen[target] = true
				Damage:Spell(p.Owner, target, p.Spell, now, self.FX, p.Multiplier)
			end
		end
	end
	self:Remove(p)
end
function Projectiles:Parry(p, target, now)
	if target.MagicId ~= "Anti" or now >= target.ParryUntil then return false end
	if target.Root.CFrame.LookVector:Dot(-p.Direction) < .15 then return false end
	-- A parry never erases an ultimate. It softens one impact and consumes the window.
	if not p.Spell.Reflectable or p.Power > 100 then
		p.Multiplier *= .65
		target.ParryUntil = 0
		World:Pulse("Parry", target.Root.Position, "Anti", 5)
		return false
	elseif p.Reflections >= 1 then
		self:Remove(p)
	else
		local delta = p.Owner.Root.Position - target.Root.Position
		p.Owner, p.Epoch, p.Seen, p.Target = target, target.MagicEpoch, {}, nil
		p.Reflections += 1
		p.Direction = delta.Magnitude > .01 and delta.Unit or -p.Direction
		p.Position = target.Root.Position + p.Direction * (p.Radius + 2.5)
		p.Next, p.Previous = p.Position, p.Position
		p.Traveled = 0
		p.Power *= .85
		p.Multiplier *= .85
		p.Root.Owner.Value = target.Model
	end
	target.CounterUntil = now + 2
	target.Mana = math.min(target.MaxMana, target.Mana + 5)
	World:Pulse("Parry", target.Root.Position, "Anti", 8)
	return true
end
function Projectiles:Cut(source, power, radius)
	for _, p in self.Items do
		if p.Owner == source then continue end
		local delta = p.Position - source.Root.Position
		if delta.Magnitude < radius and (delta.Magnitude < .1 or source.Root.CFrame.LookVector:Dot(delta.Unit) > -.1) then
			if p.Power <= power then World:Pulse("Clash", p.Position, "Anti", 5); self:Remove(p) end
		end
	end
end
function Projectiles:Deflect(source, center, radius, now)
	for _, p in self.Items do
		local delta = p.Position - center
		if p.Owner ~= source and p.Element ~= "Anti" and delta.Magnitude < radius and now >= (p.DeflectReady or 0) then
			local tangent = Vector3.new(-delta.Z, .1, delta.X)
			if tangent.Magnitude > .01 then p.Direction = (p.Direction + tangent.Unit * .65).Unit end
			p.DeflectReady = now + .7
			p.Power *= .9
		end
	end
end
function Projectiles:Step(dt, now)
	for _, p in self.Items do
		if not Registry:Alive(p.Owner) or p.Owner.MagicEpoch ~= p.Epoch then self:Remove(p); continue end
		if p.Traveled >= p.Range or now - p.Born > 12 then self:Impact(p, p.Position, now); continue end
		if p.Target and Registry:Alive(p.Target) then
			local offset = p.Target.Root.Position - p.Position
			if offset.Magnitude > .01 then p.Direction = p.Direction:Lerp(offset.Unit, math.min(1, dt * p.Spell.Homing)).Unit end
		end
		p.Previous = p.Position
		p.Next = p.Position + p.Direction * math.min(p.Range - p.Traveled, p.Speed * dt)
		local travel = p.Next - p.Previous
		p.Obstacle = travel.Magnitude > .001 and workspace:Spherecast(p.Previous, math.min(p.Radius, 8), travel, Hitbox:WorldParams(p.Owner)) or nil
		if p.Obstacle then p.Next = p.Previous + travel.Unit * p.Obstacle.Distance end
	end
	Clash:Step(self)
	for _, p in self.Items do
		local move = p.Next - p.Previous
		local obstacle = p.Obstacle
		if move.Magnitude < .001 and not obstacle then continue end
		local finish = p.Next
		local parried = false
		for _, entry in Hitbox:Segment(p.Owner, p.Previous, finish, p.Radius) do
			local target = entry.State
			if p.Seen[target] then continue end
			if self:Parry(p, target, now) then parried = true; break end
			p.Seen[target] = true
			Damage:Spell(p.Owner, target, p.Spell, now, self.FX, p.Multiplier, p.Previous)
			if not p.Spell.Pierce then self:Impact(p, target.Root.Position, now); break end
		end
		if p.Removed then continue end
		if parried then p.Root.CFrame = CFrame.lookAt(p.Position, p.Position + p.Direction); continue end
		if obstacle then
			Constructs:Damage(obstacle.Instance, p.Spell.ConstructDamage or p.Spell.Damage * p.Multiplier, p.Owner)
			self:Impact(p, finish, now)
			continue
		end
		p.Traveled += move.Magnitude
		p.Position = p.Next
		p.Root.CFrame = CFrame.lookAt(p.Position, p.Position + p.Direction)
	end
end
function Projectiles:RemoveOwner(owner)
	for _, p in self.Items do if p.Owner == owner then self:Remove(p) end end
	for context in self.Reservations do if context.Owner == owner then self:Release(context) end end
end
return Projectiles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="874">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!nonstrict
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.BlackClover.Shared.Config)
local Rules = require(ReplicatedStorage.BlackClover.Shared.Rules)
local CollectionService = game:GetService("CollectionService")
local Mana = require(script.Parent.ManaManager)
local MagicConfig = require(ReplicatedStorage.BlackClover.Shared.MagicConfig)

local Registry = { Actors = {}, ByPlayer = {} }

function Registry:Add(model, player, kind)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	assert(humanoid and root, "Combat actor needs Humanoid and HumanoidRootPart")
	local now = workspace:GetServerTimeNow()
	local state = {
		Model = model, Humanoid = humanoid, Root = root, Player = player, Kind = kind,
		Level = 1, Mana = Config.Player.Mana, MaxMana = Config.Player.Mana,
		Guard = Config.Combat.GuardMax, Blocking = false, Sprinting = false,
		Combo = 0, LastAttack = -math.huge, AttackReady = 0, BusyUntil = 0, StunUntil = 0,
		DashUntil = 0, DashReady = 0, LastDamage = now, LastManaUse = 0, LastGuard = 0,
		LastPosition = root.Position, LastCFrame = root.CFrame, LastMotion = now,
		MotionGrace = now + 1, Generation = 0, Connections = {},
		MagicId = "", Awakened = false, MagicEpoch = 0, CastGeneration = 0, Cooldowns = {},
		RootedUntil = 0, SlowUntil = 0, SlowStacks = 0, SuppressedUntil = 0, ParryUntil = 0,
		AwakeningReady = 0, SelectReady = 0, FlightReady = 0, AirDashes = 0,
	}
	humanoid.MaxHealth = kind == "Dummy" and Config.Training.DummyHealth
		or (kind == "Enemy" and Config.Training.EnemyHealth or Config.Player.Health)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = Config.Movement.Walk
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.Movement.Jump
	humanoid.BreakJointsOnDeath = false
	model:SetAttribute("ActorKind", kind)
	model:SetAttribute("Level", 1)
	model:SetAttribute("MagicName", "Без магии")
	model:SetAttribute("MagicId", "")
	model:SetAttribute("Awakened", false)
	model:SetAttribute("CastSpell", "")
	model:SetAttribute("AttackStart", 0)
	model:SetAttribute("AttackIndex", 0)
	model:SetAttribute("DashUntil", 0)
	self.Actors[model] = state
	if player then self.ByPlayer[player] = state end
	CollectionService:AddTag(model, "BCActor")
	self:Publish(state)
	return state
end

function Registry:Remove(model)
	local state = self.Actors[model]
	if not state then return end
	if state.Removing then return end
	state.Removing = true
	if self.OnRemoving then self.OnRemoving(state) end
	state.Generation += 1
	state.MagicEpoch += 1
	state.CastGeneration += 1
	for _, connection in state.Connections do connection:Disconnect() end
	if state.DashConstraint then state.DashConstraint:Destroy() end
	if state.DashAttachment then state.DashAttachment:Destroy() end
	self.Actors[model] = nil
	if state.Player and self.ByPlayer[state.Player] == state then self.ByPlayer[state.Player] = nil end
	CollectionService:RemoveTag(model, "BCActor")
end

function Registry:Alive(state)
	return state and not state.Removing and self.Actors[state.Model] == state and state.Model.Parent ~= nil
		and state.Root.Parent ~= nil and state.Humanoid.Health > 0
end

function Registry:Publish(state)
	local model = state.Model
	model:SetAttribute("Mana", state.Mana)
	model:SetAttribute("MaxMana", state.MaxMana)
	model:SetAttribute("Guard", state.Guard)
	model:SetAttribute("Blocking", state.Blocking)
	model:SetAttribute("Sprinting", state.Sprinting)
	model:SetAttribute("StunUntil", state.StunUntil)
	model:SetAttribute("DashReady", state.DashReady)
	model:SetAttribute("RootedUntil", state.RootedUntil)
	model:SetAttribute("SuppressedUntil", state.SuppressedUntil)
	model:SetAttribute("SlowStacks", state.SlowUntil > workspace:GetServerTimeNow() and state.SlowStacks or 0)
end

function Registry:FromPart(part)
	local current = part
	while current and current ~= workspace do
		if self.Actors[current] then return self.Actors[current] end
		current = current.Parent
	end
	return nil
end

function Registry:Step(dt, now)
	for _, state in self.Actors do
		if not self:Alive(state) then continue end
		Mana:Step(state, dt, now)
		if not state.Blocking and now - state.LastGuard >= Config.Combat.GuardRegenDelay then
			local guardDt = math.min(dt, math.max(0, now - state.LastGuard - Config.Combat.GuardRegenDelay))
			state.Guard = Rules.regenerate(state.Guard, Config.Combat.GuardMax, Config.Combat.GuardRegen, guardDt)
		end
		local delay = state.Kind == "Dummy" and 3 or Config.Player.HealthRegenDelay
		if now - state.LastDamage >= delay then
			local rate = state.Kind == "Dummy" and 35 or Config.Player.HealthRegen
			if state.MagicId == "Water" then rate += MagicConfig.Passives.WaterRegen end
			local healthDt = math.min(dt, math.max(0, now - state.LastDamage - delay))
			state.Humanoid.Health = Rules.regenerate(state.Humanoid.Health, state.Humanoid.MaxHealth, rate, healthDt)
		end
	end
end

return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="875">
        <Properties>
          <string name="Name">SpellExecutor</string>
          <string name="Source"><![CDATA[--!nonstrict
local Registry = require(script.Parent.Registry)
local Hitbox = require(script.Parent.MagicHitboxService)
local Projectiles = require(script.Parent.ProjectileService)
local Fields = require(script.Parent.FieldService)
local Constructs = require(script.Parent.ConstructService)
local Motion = require(script.Parent.MagicMotionService)
local Summons = require(script.Parent.SummonService)
local World = require(script.Parent.MagicWorld)
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicConfig)
local Executor = { Handlers = {} }
local H = Executor.Handlers
local projectileKinds = { Projectile = true, Dive = true, Volley = true, Rain = true, Judgment = true }
local fieldKinds = { Spikes = true, Tornado = true, Prison = true, Hand = true, Domain = true, Spin = true, Judgment = true }
function Executor:Reserve(context)
	local spell = context.Spell
	if projectileKinds[spell.Kind] and not Projectiles:Reserve(context, spell.Count) then return false end
	local amount = (spell.Kind == "Spikes" or spell.Kind == "Tornado") and spell.Count or 1
	if fieldKinds[spell.Kind] and not Fields:Reserve(context, amount) then Projectiles:Release(context); return false end
	return true
end
function Executor:Release(context) Projectiles:Release(context); Fields:Release(context) end
function Executor:Delay(context, delay, callback)
	task.delay(delay, function()
		if not Registry:Alive(context.Owner) or context.Owner.MagicEpoch ~= context.Epoch then self:Release(context); return end
		callback()
	end)
end
function Executor:Execute(context)
	local handler = H[context.Spell.Kind]
	assert(handler, "Unimplemented spell kind: " .. context.Spell.Kind)
	context.Now = workspace:GetServerTimeNow()
	return handler(context) ~= false
end
H.Projectile = function(ctx)
	local origin = ctx.Owner.Root.Position + Vector3.new(0, 1, 0) + ctx.Direction * 2.5
	return Projectiles:Create(ctx, origin, ctx.Direction) ~= nil
end
H.Dive = function(ctx)
	local ground = Hitbox:Ground(ctx.Point, ctx.Owner)
	if not ground then return false end
	local origin = ground + Vector3.new(0, 45, 0) - ctx.Direction * 16
	return Projectiles:Create(ctx, origin, (ground - origin).Unit, { Range = 80 }) ~= nil
end
H.Volley = function(ctx)
	for i = 1, ctx.Spell.Count do
		Executor:Delay(ctx, (i - 1) * ctx.Spell.Interval, function()
			local spread = (i - (ctx.Spell.Count + 1) / 2) / math.max(1, ctx.Spell.Count - 1) * ctx.Spell.Spread
			local direction = (CFrame.fromAxisAngle(Vector3.yAxis, math.rad(spread)) * ctx.Direction).Unit
			Projectiles:Create(ctx, ctx.Owner.Root.Position + Vector3.new(0, 1, 0) + direction * 2.5, direction)
		end)
	end
end
H.Shield = function(ctx)
	local spell, state = ctx.Spell, ctx.Owner
	state.Shield = { Until = ctx.Now + spell.Duration, HP = spell.ShieldHP, Reduction = spell.Reduction }
	state.Model:SetAttribute("ShieldVisual", spell.Visual)
	state.Model:SetAttribute("ShieldUntil", state.Shield.Until)
	World:Pulse("Shield", state.Root.Position, spell.ElementType, spell.Radius)
end
H.DashStrike = function(ctx) return Motion:Dash(ctx) end
H.Teleport = function(ctx) return Motion:Teleport(ctx) end
H.Wall = function(ctx) return Constructs:Wall(ctx) ~= nil end
H.Summon = function(ctx) return Summons:Create(ctx) end
H.Parry = function(ctx)
	ctx.Owner.ParryUntil = ctx.Now + ctx.Spell.Duration + Config.Passives.AntiParryBonus
	ctx.Owner.Model:SetAttribute("ParryUntil", ctx.Owner.ParryUntil)
	World:Pulse("ParryReady", ctx.Owner.Root.Position, "Anti", 5)
end
H.Spikes = function(ctx)
	if not Hitbox:Ground(ctx.Owner.Root.Position, ctx.Owner) then return false end
	local direction = Vector3.new(ctx.Direction.X, 0, ctx.Direction.Z)
	if direction.Magnitude < .1 then direction = Vector3.new(0, 0, -1) end
	direction = direction.Unit
	local origin = ctx.Owner.Root.Position
	for i = 1, ctx.Spell.Count do
		Executor:Delay(ctx, (i - 1) * ctx.Spell.Interval, function()
			local ground = Hitbox:Ground(origin + direction * (4 + i * 6), ctx.Owner)
			if ground then Fields:Create(ctx, "Spike", ground, { Until = workspace:GetServerTimeNow() + 1.2, Activation = workspace:GetServerTimeNow() + .2 }) end
		end)
	end
	Executor:Delay(ctx, ctx.Spell.Count * ctx.Spell.Interval + .1, function() Fields:Release(ctx) end)
end
H.Tornado = function(ctx)
	local right = ctx.Owner.Root.CFrame.RightVector
	local created = 0
	for i = 1, ctx.Spell.Count do
		local point = ctx.Owner.Root.Position + ctx.Direction * 8 + right * (i - (ctx.Spell.Count + 1) / 2) * 12
		local ground = Hitbox:Ground(point, ctx.Owner)
		if ground and Fields:Create(ctx, "Tornado", ground + Vector3.new(0, 3, 0)) then created += 1 end
	end
	Fields:Release(ctx)
	return created > 0
end
H.Prison = function(ctx)
	local nearest = Hitbox:Nearest(ctx.Owner, ctx.Point, 12)
	local ground = Hitbox:Ground(nearest and nearest.Root.Position or ctx.Point, ctx.Owner)
	if not ground then return false end
	return Fields:Create(ctx, "Prison", ground + Vector3.new(0, 1, 0)) ~= nil
end
H.Hand = function(ctx)
	local ground = Hitbox:Ground(ctx.Point, ctx.Owner)
	if not ground then return false end
	return Fields:Create(ctx, "Hand", ground + Vector3.new(0, 1, 0)) ~= nil
end
H.Domain = function(ctx)
	local ground = Hitbox:Ground(ctx.Point, ctx.Owner)
	if not ground then return false end
	if ctx.Spell.LiftCaster and not ctx.Owner.Root.Anchored then
		ctx.Owner.Root:ApplyImpulse(Vector3.new(0, 52, 0) * ctx.Owner.Root.AssemblyMass)
		ctx.Owner.MotionGrace = ctx.Now + 1
	end
	return Fields:Create(ctx, "Domain", ground + Vector3.new(0, 1, 0)) ~= nil
end
H.Spin = function(ctx) return Fields:Create(ctx, "Spin", ctx.Owner.Root.Position) ~= nil end
H.Rain = function(ctx)
	if not Hitbox:Ground(ctx.Point, ctx.Owner) then return false end
	local random = Random.new(ctx.Serial * 31)
	for i = 1, ctx.Spell.Count do
		local angle, distance = random:NextNumber(0, math.pi * 2), math.sqrt(random:NextNumber()) * ctx.Spell.Radius
		local point = ctx.Point + Vector3.new(math.cos(angle) * distance, 0, math.sin(angle) * distance)
		Executor:Delay(ctx, (i - 1) * ctx.Spell.Interval, function()
			local ground = Hitbox:Ground(point, ctx.Owner)
			if ground then Projectiles:Create(ctx, ground + Vector3.new(0, 36, 0), Vector3.new(0, -1, 0), { Radius = 1, Range = 55 }) end
		end)
	end
	Executor:Delay(ctx, ctx.Spell.Count * ctx.Spell.Interval + .1, function() Projectiles:Release(ctx) end)
end
H.Judgment = function(ctx)
	local ground = Hitbox:Ground(ctx.Point, ctx.Owner)
	if not ground then return false end
	Fields:Create(ctx, "Judgment", ground + Vector3.new(0, 1, 0))
	for i = 1, ctx.Spell.Count do
		local angle = i * math.pi * 2 / ctx.Spell.Count
		local origin = ground + Vector3.new(math.cos(angle) * 23, 25, math.sin(angle) * 23)
		Executor:Delay(ctx, .9 + (i % 3) * .04, function()
			Projectiles:Create(ctx, origin, (ground - origin).Unit, { Radius = 1.5, Speed = 100, Range = 60 })
		end)
	end
end
return Executor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="876">
        <Properties>
          <string name="Name">StatusService</string>
          <string name="Source"><![CDATA[--!nonstrict
local Registry = require(script.Parent.Registry)
local Status = {}
function Status:Root(state, seconds, now)
	if not Registry:Alive(state) or state.Model:FindFirstChildOfClass("ForceField") then return false end
	state.RootedUntil = math.max(state.RootedUntil, now + math.min(seconds, 2.5))
	state.RootAnchor = state.Root.Position
	state.CastGeneration += 1
	state.Generation += 1
	state.Blocking = false
	state.Model:SetAttribute("CastSpell", "")
	state.Model:SetAttribute("AttackStart", 0)
	return true
end
function Status:Grab(state, position, seconds, now)
	self:Root(state, seconds, now)
	if not state.Root.Anchored then state.GrabPosition, state.GrabUntil = position, now + seconds end
end
function Status:Step(now)
	for _, state in Registry.Actors do
		if not Registry:Alive(state) then continue end
		if state.Shield and now >= state.Shield.Until then state.Shield = nil; state.Model:SetAttribute("ShieldVisual", "") end
		if now < state.RootedUntil then
			if not state.Root.Anchored then
				state.Root:SetNetworkOwner(nil)
				state.ControlOwned = true
				local anchor = state.RootAnchor or state.Root.Position
				local point = state.GrabPosition and now < (state.GrabUntil or 0) and state.GrabPosition
					or Vector3.new(anchor.X, state.Root.Position.Y, anchor.Z)
				state.Root.CFrame = CFrame.new(point) * state.Root.CFrame.Rotation
				state.Root.AssemblyLinearVelocity = Vector3.new(0, state.GrabPosition and 0 or state.Root.AssemblyLinearVelocity.Y, 0)
				state.MotionGrace = now + .3
			end
		elseif state.ControlOwned then
			state.ControlOwned, state.GrabPosition = nil, nil
			if state.Player and not state.DashDirection and not state.FlightConstraint and not state.Root.Anchored then state.Root:SetNetworkOwnershipAuto() end
		end
	end
end
return Status
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="877">
        <Properties>
          <string name="Name">SummonService</string>
          <string name="Source"><![CDATA[--!nonstrict
local ServerStorage = game:GetService("ServerStorage")
local Registry = require(script.Parent.Registry)
local Hitbox = require(script.Parent.MagicHitboxService)
local Damage = require(script.Parent.DamageService)
local World = require(script.Parent.MagicWorld)
local Summons = { Items = {} }
function Summons:Remove(owner)
	local record = self.Items[owner]
	if not record then return end
	self.Items[owner] = nil
	owner.Model:SetAttribute("HasGolem", false)
	World:Pulse("Shatter", record.State.Root.Position, "Earth", 12, "Golem")
	Registry:Remove(record.State.Model)
	record.State.Model:Destroy()
end
function Summons:Create(context)
	local owner, spell = context.Owner, context.Spell
	self:Remove(owner)
	local ground = Hitbox:Ground(owner.Root.Position + context.Direction * 10, owner)
	if not ground then return false end
	local model = ServerStorage.Actors.Golem:Clone()
	model:ScaleTo(2.2)
	model:PivotTo(CFrame.new(ground + Vector3.new(0, 7, 0)))
	model.Name, model.Parent = "Голем матери земли", workspace.TrainingActors
	local state = Registry:Add(model, nil, "Golem")
	state.Owner, state.BaseSpeed = owner, 15
	state.Humanoid.MaxHealth, state.Humanoid.Health = spell.SummonHP, spell.SummonHP
	state.Root:SetNetworkOwner(nil)
	for _, part in model:GetDescendants() do if part:IsA("BasePart") then part.CollisionGroup = "BCActors" end end
	self.Items[owner] = { Owner = owner, State = state, Epoch = owner.MagicEpoch, Spell = spell,
		Until = workspace:GetServerTimeNow() + spell.Duration, NextAttack = 0, Attacks = 0 }
	owner.Model:SetAttribute("HasGolem", true)
	table.insert(state.Connections, state.Humanoid.Died:Connect(function() self:Remove(owner) end))
	World:Pulse("Summon", ground, "Earth", 10, "Golem")
	return true
end
function Summons:Step(now)
	for owner, record in self.Items do
		local state = record.State
		if not Registry:Alive(owner) or not Registry:Alive(state) or owner.MagicEpoch ~= record.Epoch or now >= record.Until then self:Remove(owner); continue end
		if now < state.StunUntil or now < state.RootedUntil then continue end
		local target = Hitbox:Nearest(state, state.Root.Position, 55)
		if not target then state.Humanoid:MoveTo(owner.Root.Position + Vector3.new(6, 0, 6)); continue end
		if (state.Root.Position - owner.Root.Position).Magnitude > 90 then state.Humanoid:MoveTo(owner.Root.Position); continue end
		local delta = target.Root.Position - state.Root.Position
		if delta.Magnitude > 10 then state.Humanoid:MoveTo(target.Root.Position); continue end
		state.Humanoid:MoveTo(state.Root.Position)
		if now < record.NextAttack then continue end
		local flat = Vector3.new(delta.X, 0, delta.Z)
		if flat.Magnitude > .1 then state.Root.CFrame = CFrame.lookAt(state.Root.Position, state.Root.Position + flat) end
		record.Attacks += 1
		local slam = record.Attacks % 4 == 0
		local index = slam and 4 or (record.Attacks % 3 + 1)
		state.Generation += 1
		local generation = state.Generation
		state.BusyUntil, record.NextAttack = now + .8, now + 1.5
		state.Model:SetAttribute("AttackIndex", index)
		state.Model:SetAttribute("AttackStart", now)
		task.delay(slam and .23 or .19, function()
			if not Registry:Alive(state) or state.Generation ~= generation or self.Items[owner] ~= record then return end
			local definition = table.clone(record.Spell)
			definition.Damage, definition.Knockback = slam and record.Spell.SlamDamage or record.Spell.Damage, slam and 24 or 8
			for _, victim in Hitbox:Area(state, state.Root.Position, slam and 17 or 11, true) do
				Damage:Spell(state, victim, definition, workspace:GetServerTimeNow(), self.FX)
			end
			World:Pulse(slam and "Final" or "Impact", state.Root.Position - Vector3.new(0, 5, 0), "Earth", slam and 15 or 5)
		end)
	end
end
return Summons
]]></string>
        </Properties>
      </Item>
