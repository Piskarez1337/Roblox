        </Properties>
        <Item class="ModuleScript" referent="1359">
          <Properties>
            <string name="Name">AnimationController</string>
            <string name="Source"><![CDATA[--!nonstrict
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Pose = require(game:GetService("ReplicatedStorage").BlackClover.Shared:WaitForChild("PoseLibrary"))
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Config)
local MagicAnimation = require(script.Parent:WaitForChild("MagicAnimationController"))
local Controller = { Actors = {}, Prediction = nil }

function Controller:Add(model)
	if self.Actors[model] then return end
	local entry = { Motors = {}, Phase = 0, Speed = 0, BrakeAt = 0 }
	self.Actors[model] = entry
	local function addMotor(item)
		if item:IsA("Motor6D") then entry.Motors[item.Name] = item end
	end
	for _, item in model:GetDescendants() do addMotor(item) end
	entry.Connection = model.DescendantAdded:Connect(addMotor)
end

function Controller:Remove(model)
	local entry = self.Actors[model]
	if not entry then return end
	entry.Connection:Disconnect()
	for _, motor in entry.Motors do if motor.Parent then motor.Transform = CFrame.identity end end
	self.Actors[model] = nil
	if self.Prediction and self.Prediction.Model == model then self.Prediction = nil end
end

function Controller:Predict(model, index, now)
	self.Prediction = { Model = model, Index = index, Start = now, Previous = model:GetAttribute("AttackStart") or 0 }
end

function Controller:CancelPrediction() self.Prediction = nil end

function Controller:Start()
	for _, model in CollectionService:GetTagged("BCActor") do self:Add(model) end
	CollectionService:GetInstanceAddedSignal("BCActor"):Connect(function(model) self:Add(model) end)
	CollectionService:GetInstanceRemovedSignal("BCActor"):Connect(function(model) self:Remove(model) end)
	RunService.PreSimulation:Connect(function(dt)
		local now = workspace:GetServerTimeNow()
		for model, entry in self.Actors do
			local root, humanoid = model:FindFirstChild("HumanoidRootPart"), model:FindFirstChildOfClass("Humanoid")
			if not root or not humanoid then continue end
			local camera = workspace.CurrentCamera
			if camera and (root.Position - camera.CFrame.Position).Magnitude > Config.Network.MaxVFXDistance then continue end
			local localVelocity = root.CFrame:VectorToObjectSpace(root.AssemblyLinearVelocity)
			local speed = Vector3.new(localVelocity.X, 0, localVelocity.Z).Magnitude
			if entry.Speed > 18 and speed < 3 then entry.BrakeAt = now end
			entry.Speed = speed
			entry.Phase += dt * (speed > 0.7 and speed * 0.63 or 2)
			local airborne = humanoid.FloorMaterial == Enum.Material.Air and not root.Anchored
			local pose = Pose.Locomotion(speed, model:GetAttribute("Sprinting") == true, airborne, entry.Phase, localVelocity)
			pose = MagicAnimation:Stance(model, pose, speed, now)
			local index, start = model:GetAttribute("AttackIndex") or 0, model:GetAttribute("AttackStart") or 0
			local prediction = self.Prediction
			if prediction and prediction.Model == model then
				if start ~= prediction.Previous or now - prediction.Start > 0.4 then
					self.Prediction = nil
				else
					index, start = prediction.Index, prediction.Start
				end
			end
			local attack = start > 0 and Pose.Attack(index, now - start)
			local weaponAttack = start > 0 and MagicAnimation:Melee(model, index, now - start)
			if weaponAttack then attack = weaponAttack end
			local casting = MagicAnimation:GetPose(model, now)
			if humanoid.Health <= 0 then pose = {}
			elseif (model:GetAttribute("StunUntil") or 0) > now then pose = Pose.Stagger(now - (model:GetAttribute("HitAt") or now))
			elseif casting then pose = casting
			elseif (model:GetAttribute("DashUntil") or 0) > now then pose = Pose.Dash()
			elseif attack then pose = attack
			elseif model:GetAttribute("Blocking") then pose = Pose.Block()
			elseif now - entry.BrakeAt < 0.24 then pose = Pose.Brake(1 - (now - entry.BrakeAt) / 0.24) end
			local smoothing = 1 - math.exp(-(attack and 42 or 17) * dt)
			for name, motor in entry.Motors do
				if motor.Parent then motor.Transform = motor.Transform:Lerp(pose[name] or CFrame.identity, smoothing) end
			end
		end
	end)
end

return Controller
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="1360">
          <Properties>
            <string name="Name">Bootstrap</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer
local package = ReplicatedStorage:WaitForChild("BlackClover")
local shared = package:WaitForChild("Shared")
local Config = require(shared:WaitForChild("Config"))
local Rules = require(shared:WaitForChild("Rules"))
local Animation = require(script.Parent:WaitForChild("AnimationController"))
local VFX = require(script.Parent:WaitForChild("VFXController"))
local HUD = require(script.Parent:WaitForChild("HUDController"))
local MagicHUD = require(script.Parent:WaitForChild("MagicHUD"))
local MagicEquipment = require(script.Parent:WaitForChild("MagicEquipment"))
local MagicVFX = require(script.Parent:WaitForChild("MagicVFX"))
local remotes = package:WaitForChild("Remotes")
local action = remotes:WaitForChild("Action")
local attackHeld, queuedUntil, nextAttack = false, 0, 0
local sprintHeld, blockHeld = false, false
local nextBlockTry = 0

Animation:Start()
VFX:Start()
HUD:Start()
MagicEquipment:Start()
remotes:WaitForChild("MagicFX")
MagicHUD:Start(HUD.Canvas, action, remotes)
MagicVFX:Start(remotes.MagicFX)

local function resetInput()
	attackHeld, queuedUntil, nextAttack = false, 0, 0
	sprintHeld, blockHeld = false, false
	action:FireServer("Block", false)
	action:FireServer("Sprint", false)
	Animation:CancelPrediction()
end

local function attack(now)
	if MagicHUD.Menu.Visible then return end
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or now < nextAttack or blockHeld then return end
	if (character:GetAttribute("StunUntil") or 0) > now or (character:GetAttribute("DashUntil") or 0) > now
		or (character:GetAttribute("RootedUntil") or 0) > now
		or (character:GetAttribute("CastSpell") ~= "" and (character:GetAttribute("CastEnd") or 0) > now) then return end
	local index = Rules.nextCombo(character:GetAttribute("AttackIndex") or 0, character:GetAttribute("AttackStart") or 0,
		now, Config.Combat.ComboReset)
	-- The server confirms or rejects this cosmetic prediction. It never grants damage.
	Animation:Predict(character, index, now)
	nextAttack = now + Config.Combat.Attacks[index].Recovery + 0.025
	queuedUntil = 0
	action:FireServer("Attack")
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() or MagicHUD.Menu.Visible then return end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		attackHeld = true
		queuedUntil = workspace:GetServerTimeNow() + 0.16
		attack(workspace:GetServerTimeNow())
	elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprintHeld = true
		action:FireServer("Sprint", true)
	elseif input.KeyCode == Enum.KeyCode.F then
		blockHeld = true
		nextBlockTry = workspace:GetServerTimeNow() + 0.25
		action:FireServer("Block", true)
	elseif input.KeyCode == Enum.KeyCode.Q then
		local character = localPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid then action:FireServer("Dash", humanoid.MoveDirection) end
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then attackHeld = false
	elseif input.KeyCode == Enum.KeyCode.F then
		blockHeld = false
		action:FireServer("Block", false)
		if sprintHeld then action:FireServer("Sprint", true) end
	elseif input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift then
		sprintHeld = false
		action:FireServer("Sprint", false)
	end
end)
UserInputService.WindowFocusReleased:Connect(resetInput)
UserInputService.TextBoxFocused:Connect(resetInput)
localPlayer.CharacterAdded:Connect(function()
	resetInput()
	HUD.CreatedAt = os.clock()
end)
localPlayer.CharacterRemoving:Connect(resetInput)
MagicHUD.Menu:GetPropertyChangedSignal("Visible"):Connect(function() if MagicHUD.Menu.Visible then resetInput() end end)

remotes:WaitForChild("FX").OnClientEvent:Connect(function(kind, ...)
	if kind == "Rejected" then
		local rejected = ...
		if rejected == "Attack" then Animation:CancelPrediction(); nextAttack = workspace:GetServerTimeNow() + 0.14 end
		return
	end
	VFX:Handle(kind, ...)
end)

RunService.Heartbeat:Connect(function()
	local now = workspace:GetServerTimeNow()
	if attackHeld or now < queuedUntil then attack(now) end
	local character = localPlayer.Character
	if blockHeld and character and not character:GetAttribute("Blocking") and now >= nextBlockTry then
		nextBlockTry = now + 0.25
		action:FireServer("Block", true)
	end
end)

-- Run before the default camera so CameraOffset is included without cumulative drift.
RunService:BindToRenderStep("BlackCloverPresentation", Enum.RenderPriority.Camera.Value - 1, function(dt)
	HUD:Step(dt)
	VFX:Step(dt)
	local character = localPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local camera = workspace.CurrentCamera
	if humanoid and camera then
		local t = os.clock() * 58
		humanoid.CameraOffset = Vector3.new(math.sin(t) * VFX.Shake, math.cos(t * 1.17) * VFX.Shake * 0.65, 0)
		local desired = character:GetAttribute("Sprinting") and humanoid.MoveDirection.Magnitude > 0 and 77 or 70
		local age = workspace:GetServerTimeNow() - (character:GetAttribute("TransformStart") or 0)
		if character:GetAttribute("Awakened") and age >= 0 and age < 2.4 then desired = 70 - math.sin(age / 2.4 * math.pi) * 11 end
		camera.FieldOfView += (desired - camera.FieldOfView) * (1 - math.exp(-7 * dt))
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1361">
          <Properties>
            <string name="Name">GrimoireManager</string>
            <string name="Source"><![CDATA[--!nonstrict
local Geometry = require(script.Parent.MagicGeometry)
local Art = require(script.Parent.MagicArt)
local Books = {}
local glyphs = { Water = "≈", Wind = "≋", Earth = "◇", Ice = "❄", Bone = "☽", Stars = "✦", Anti = "♣" }
function Books:Create(element, parent)
	local model = Geometry.Model(element .. "Grimoire")
	local color, accent = Art:Color(element), Art:Color(element, true)
	local root = model.PrimaryPart
	local coverColor = color:Lerp(Color3.fromRGB(15, 20, 30), .55)
	local entry = { Model = model, Open = 0, Hinges = {}, Page = nil }
	local glow = Instance.new("PointLight")
	glow.Color, glow.Brightness, glow.Range, glow.Shadows, glow.Parent = color, .35, 5, false, root
	local spine = Geometry.Part(model, "Spine", Vector3.new(.18, 1.6, .26), CFrame.identity, accent)
	spine.Anchored = false
	local spineWeld = Instance.new("WeldConstraint")
	spineWeld.Part0, spineWeld.Part1, spineWeld.Parent = root, spine, spine
	for _, sign in { -1, 1 } do
		local cover = Geometry.Part(model, "EmbossedCover", Vector3.new(1.15, 1.6, .1), CFrame.new(sign * .6, 0, sign * .08), coverColor)
		local page = Geometry.Part(model, "Pages", Vector3.new(1.05, 1.44, .08), cover.CFrame * CFrame.new(0, 0, -.08), Color3.fromRGB(228, 222, 194))
		local pieces = { page }
		local motifs = ({ Water = 3, Wind = 4, Earth = 2, Ice = 6, Bone = 5, Stars = 7, Anti = 1 })[element]
		for i = 1, motifs do
			local angle = i * math.pi * 2 / motifs
			local gem = Geometry.Part(model, "ElementSeal", Vector3.new(.075, .12, .04), cover.CFrame * CFrame.new(math.cos(angle) * .32, math.sin(angle) * .48, .09) * CFrame.Angles(0, 0, angle), color, Enum.Material.Neon, "Wedge")
			table.insert(pieces, gem)
		end
		for _, x in { -.45, .45 } do
			for _, y in { -.65, .65 } do
				table.insert(pieces, Geometry.Part(model, "CornerOrnament", Vector3.new(.2, .18, .05), cover.CFrame * CFrame.new(x, y, .08), accent, Enum.Material.Metal))
			end
		end
		for i = 1, 4 do table.insert(pieces, Geometry.Part(model, "PageEdge", Vector3.new(1.04, .012, .01), cover.CFrame * CFrame.new(0, -.48 + i * .21, -.13), Color3.fromRGB(148, 136, 111))) end
		local surface = Instance.new("SurfaceGui")
		surface.Face, surface.CanvasSize, surface.Parent = Enum.NormalId.Back, Vector2.new(180, 240), cover
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.Font, label.TextSize = glyphs[element], Enum.Font.GothamBold, 110
		label.TextColor3, label.Parent = accent, surface
		for _, part in pieces do
			part.Anchored = false
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = cover, part, part
		end
		cover.Anchored = false
		local motor = Instance.new("Motor6D")
		motor.Part0, motor.Part1 = root, cover
		motor.C0, motor.C1 = CFrame.new(0, 0, sign * .08), CFrame.new(-sign * .6, 0, 0)
		motor.Parent = cover
		entry.Hinges[sign] = motor
	end
	local leaf = Geometry.Part(model, "TurningPage", Vector3.new(1.08, 1.44, .012), CFrame.new(.56, 0, -.12), Color3.fromRGB(248, 242, 216))
	leaf.Anchored = false
	local hinge = Instance.new("Motor6D")
	hinge.Part0, hinge.Part1 = root, leaf
	hinge.C0, hinge.C1 = CFrame.new(0, 0, -.14), CFrame.new(-.56, 0, 0)
	hinge.Parent, entry.Page = leaf, hinge
	if not Art:Track(model) then return nil end
	model.Parent = parent
	return entry
end
function Books:Step(entry, character, dt, now)
	local torso = character:FindFirstChild("UpperTorso")
	if not torso then return end
	local casting = character:GetAttribute("CastSpell") ~= "" and (character:GetAttribute("CastEnd") or 0) > now
	entry.Open += ((casting and 1 or 0) - entry.Open) * (1 - math.exp(-12 * dt))
	entry.Model.PrimaryPart.CFrame = torso.CFrame * CFrame.new(-2.5, .5 + math.sin(now * 2.2) * .15, .65) * CFrame.Angles(-.15, math.rad(155), -.12)
	entry.Hinges[-1].Transform = CFrame.Angles(0, math.rad(178 - entry.Open * 165), 0)
	entry.Hinges[1].Transform = CFrame.Angles(0, -entry.Open * .22, 0)
	entry.Page.Transform = CFrame.Angles(0, casting and (now * 7 % math.pi) or 0, 0)
	entry.Page.Part1.Transparency = casting and .1 or 1
end
return Books
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1362">
          <Properties>
            <string name="Name">HUDController</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Config)
local MagicConfig = require(game:GetService("ReplicatedStorage").BlackClover.Shared.MagicConfig)
local HUD = { Health = 1, Mana = 1, Guard = 1 }
local ink = Color3.fromRGB(12, 23, 29)
local pale = Color3.fromRGB(230, 237, 227)
local gold = Color3.fromRGB(218, 186, 119)
local mint = Color3.fromRGB(102, 222, 202)
local muted = Color3.fromRGB(147, 167, 167)

local function create(class, properties, parent)
	local object = Instance.new(class)
	for key, value in properties do object[key] = value end
	object.Parent = parent
	return object
end
local function label(parent, text, position, size, fontSize, color)
	return create("TextLabel", { BackgroundTransparency = 1, Position = position, Size = size,
		Text = text, TextColor3 = color or pale, Font = Enum.Font.GothamMedium, TextSize = fontSize,
		TextXAlignment = Enum.TextXAlignment.Left }, parent)
end
local function panel(parent, position, size, anchor)
	local frame = create("Frame", { Position = position, Size = size, AnchorPoint = anchor or Vector2.zero,
		BackgroundColor3 = ink, BackgroundTransparency = 0.12, BorderSizePixel = 0 }, parent)
	create("UICorner", { CornerRadius = UDim.new(0, 10) }, frame)
	create("UIStroke", { Color = Color3.fromRGB(78, 99, 98), Transparency = 0.45, Thickness = 1 }, frame)
	return frame
end
local function bar(parent, y, name, color, height)
	local title = label(parent, name, UDim2.fromOffset(18, y), UDim2.fromOffset(285, 18), 11, muted)
	local track = create("Frame", { Position = UDim2.fromOffset(18, y + 22), Size = UDim2.fromOffset(284, height),
		BackgroundColor3 = Color3.fromRGB(36, 51, 57), BorderSizePixel = 0, ClipsDescendants = true }, parent)
	create("UICorner", { CornerRadius = UDim.new(0, 3) }, track)
	local fill = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BorderSizePixel = 0 }, track)
	create("UICorner", { CornerRadius = UDim.new(0, 3) }, fill)
	return { Fill = fill, Title = title }
end

function HUD:Start()
	local gui = create("ScreenGui", { Name = "BlackCloverHUD", ResetOnSpawn = false, DisplayOrder = 10,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, Players.LocalPlayer:WaitForChild("PlayerGui"))
	self.Gui = gui
	local canvas = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, gui)
	self.Canvas = canvas
	local mark = panel(canvas, UDim2.fromOffset(24, 18), UDim2.fromOffset(270, 58))
	label(mark, "♣", UDim2.fromOffset(14, 4), UDim2.fromOffset(42, 46), 38, gold)
	label(mark, "B L A C K   C L O V E R", UDim2.fromOffset(65, 9), UDim2.fromOffset(195, 20), 13, pale)
	label(mark, "ДВОР ХРАНИТЕЛЕЙ  /  ГРИМУАРЫ", UDim2.fromOffset(65, 31), UDim2.fromOffset(195, 14), 9, muted)
	local status = panel(canvas, UDim2.new(0, 24, 1, -24), UDim2.fromOffset(320, 200), Vector2.new(0, 1))
	self.Identity = label(status, "УРОВЕНЬ 01  /  БЕЗ МАГИИ", UDim2.fromOffset(18, 12), UDim2.fromOffset(284, 22), 11, gold)
	self.HPBar = bar(status, 45, "ЗДОРОВЬЕ", Color3.fromRGB(217, 122, 115), 12)
	self.MPBar = bar(status, 88, "МАНА", mint, 12)
	self.GuardBar = bar(status, 131, "ЗАЩИТА", gold, 5)
	self.State = label(status, "ГОТОВ К БОЮ", UDim2.fromOffset(18, 171), UDim2.fromOffset(284, 18), 10, muted)
	local actions = panel(canvas, UDim2.new(0.5, 0, 1, -24), UDim2.fromOffset(340, 92), Vector2.new(0.5, 1))
	label(actions, "ЛКМ  /  РУКОПАШНОЕ КОМБО", UDim2.fromOffset(14, 10), UDim2.fromOffset(205, 16), 10, muted)
	self.Pips = {}
	for i = 1, 4 do
		local pip = panel(actions, UDim2.fromOffset(14 + (i - 1) * 39, 35), UDim2.fromOffset(31, 37))
		local number = label(pip, tostring(i), UDim2.fromOffset(0, 0), UDim2.fromScale(1, 1), 15, muted)
		number.TextXAlignment = Enum.TextXAlignment.Center
		self.Pips[i] = number
	end
	self.Dash = label(actions, "Q  РЫВОК", UDim2.fromOffset(185, 28), UDim2.fromOffset(140, 22), 13, mint)
	label(actions, "8 маны · 1.15 с", UDim2.fromOffset(185, 53), UDim2.fromOffset(140, 18), 10, muted)
	local help = panel(canvas, UDim2.new(1, -24, 1, -24), UDim2.fromOffset(250, 124), Vector2.new(1, 1))
	label(help, "УПРАВЛЕНИЕ", UDim2.fromOffset(16, 12), UDim2.fromOffset(218, 18), 10, gold)
	label(help, "Shift Бег · Space Прыжок · F Блок\nЛКМ Комбо · Q Рывок · M Магия\nR Полёт · Space/Ctrl Вверх/вниз", UDim2.fromOffset(16, 38), UDim2.fromOffset(220, 67), 11, pale)
	self.Hint = label(canvas, "M — выбор магии · Z/X/C/V — способности · G — пробуждение. Источник восстанавливает HP и ману.",
		UDim2.new(0.5, 0, 0, 26), UDim2.fromOffset(670, 42), 12, pale)
	self.Hint.AnchorPoint = Vector2.new(0.5, 0)
	self.Hint.TextXAlignment = Enum.TextXAlignment.Center
	self.Hint.TextWrapped = true
	self.Hint.TextStrokeTransparency = 0.55
	self.Hint.Visible = true
	self.CreatedAt = os.clock()
	self.Dead = label(canvas, "ВЫ ПАЛИ\nВозрождение через несколько секунд", UDim2.fromScale(0.5, 0.4), UDim2.fromOffset(600, 90), 24, pale)
	self.Dead.AnchorPoint, self.Dead.TextXAlignment = Vector2.new(0.5, 0.5), Enum.TextXAlignment.Center
	self.Dead.TextStrokeTransparency, self.Dead.Visible = 0.5, false
	-- Scale the design canvas while retaining edge anchors on narrower displays.
	self.Scale = create("UIScale", { Scale = 1 }, canvas)
end

function HUD:Step(dt)
	local camera = workspace.CurrentCamera
	if camera then
		local scale = math.clamp(camera.ViewportSize.X / 1440, 0.55, 1)
		self.Scale.Scale = scale
		self.Canvas.Size = UDim2.fromScale(1 / scale, 1 / scale)
	end
	self.Hint.Visible = os.clock() - self.CreatedAt < 18
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then self.State.Text = "ВОЗРОЖДЕНИЕ…"; return end
	local now = workspace:GetServerTimeNow()
	local health, maxHealth = humanoid.Health, humanoid.MaxHealth
	local mana, maxMana = character:GetAttribute("Mana") or 0, character:GetAttribute("MaxMana") or 100
	local guard = character:GetAttribute("Guard") or 0
	local alpha = 1 - math.exp(-12 * dt)
	self.Health += (health / math.max(1, maxHealth) - self.Health) * alpha
	self.Mana += (mana / math.max(1, maxMana) - self.Mana) * alpha
	self.Guard += (guard / Config.Combat.GuardMax - self.Guard) * alpha
	self.HPBar.Fill.Size = UDim2.fromScale(math.clamp(self.Health, 0, 1), 1)
	self.MPBar.Fill.Size = UDim2.fromScale(math.clamp(self.Mana, 0, 1), 1)
	self.GuardBar.Fill.Size = UDim2.fromScale(math.clamp(self.Guard, 0, 1), 1)
	self.HPBar.Title.Text = string.format("ЗДОРОВЬЕ                                  %d / %d", math.ceil(health), maxHealth)
	self.MPBar.Title.Text = string.format("МАНА                                          %d / %d", math.floor(mana), maxMana)
	self.GuardBar.Title.Text = string.format("ЗАЩИТА                                      %d / %d", math.floor(guard), Config.Combat.GuardMax)
	self.Identity.Text = string.format("УРОВЕНЬ %02d  /  %s", character:GetAttribute("Level") or 1, string.upper(character:GetAttribute("MagicName") or "Без магии"))
	local cooldown = math.max(0, (character:GetAttribute("DashReady") or 0) - now)
	self.Dash.Text = cooldown > 0 and string.format("Q  %.1f с", cooldown) or "Q  РЫВОК"
	self.Dash.TextColor3 = cooldown > 0 and muted or mint
	local busy = now - (character:GetAttribute("AttackStart") or 0) < Config.Combat.ComboReset
	for i, pip in self.Pips do pip.TextColor3 = busy and i <= (character:GetAttribute("AttackIndex") or 0) and gold or muted end
	local stunned = (character:GetAttribute("StunUntil") or 0) > now
	self.State.Text = stunned and "ОГЛУШЕНИЕ" or (character:GetAttribute("Blocking") and "БЛОК · ЗАЩИТА СПЕРЕДИ"
		or (character:GetAttribute("Sprinting") and "СПРИНТ" or "ГОТОВ К БОЮ"))
	local class = MagicConfig.Classes[character:GetAttribute("MagicId") or ""]
	if (character:GetAttribute("SuppressedUntil") or 0) > now then self.State.Text = "МАГИЯ ПОДАВЛЕНА"
	elseif character:GetAttribute("Awakened") and class then self.State.Text = class.Awakening .. " · −" .. class.Drain .. "/с" end
	self.Dead.Visible = health <= 0
end

return HUD
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1363">
          <Properties>
            <string name="Name">MagicAnimationController</string>
            <string name="Source"><![CDATA[--!nonstrict
local shared = game:GetService("ReplicatedStorage").BlackClover.Shared
local Spells = require(shared:WaitForChild("SpellRegistry"))
local Config = require(shared.MagicConfig)
local Core = require(shared.Config)
local Animation = {}
local function r(x, y, z) return CFrame.Angles(math.rad(x or 0), math.rad(y or 0), math.rad(z or 0)) end
local function blend(a, b, t)
	local result = {}
	for key, value in a do result[key] = value:Lerp(b[key] or CFrame.identity, t) end
	for key, value in b do if not result[key] then result[key] = CFrame.identity:Lerp(value, t) end end
	return result
end
local function casting(spell, charge, released, age)
	local side = spell.Flavor % 2 == 0 and 1 or -1
	local nuance = (spell.Flavor % 5 - 2) * 3
	local pose = { Waist = r(-6, side * (8 + nuance), 0), Neck = r(5, -side * 5), RightHip = r(-8), LeftHip = r(12), LeftKnee = r(-14) }
	local style = spell.Style
	if style == "Bolt" or style == "Release" or style == "Dragon" then
		pose.RightShoulder, pose.RightElbow = r(released and 100 or 45 + charge * 20, nuance, -8), r(released and 8 or 80)
		pose.LeftShoulder, pose.LeftElbow = r(style == "Dragon" and 80 or 30, 0, -25), r(65)
		pose.Waist = r(released and -18 or -7, side * 15)
	elseif style == "Raise" or style == "Summon" or style == "Judgment" then
		local height = style == "Judgment" and 165 or (style == "Summon" and 135 or 110)
		pose.RightShoulder, pose.LeftShoulder = r(height * charge, 0, 25 + nuance), r(height * charge, 0, -25 - nuance)
		pose.RightElbow, pose.LeftElbow = r(20), r(20)
		pose.Waist, pose.Neck = r(8 * charge), r(-12 * charge)
		if released then pose.RightShoulder, pose.LeftShoulder, pose.Waist = r(80, 0, 30), r(80, 0, -30), r(-15) end
	elseif style == "Ground" then
		pose.Root = CFrame.new(0, -charge * .6, 0)
		pose.Waist, pose.RightHip, pose.LeftHip = r(-35 * charge), r(40 * charge), r(25 * charge)
		pose.RightKnee, pose.LeftKnee = r(-65 * charge), r(-55 * charge)
		pose.RightShoulder, pose.RightElbow = r(released and 15 or 155 * charge, 0, 10), r(released and 0 or 55)
		pose.LeftShoulder, pose.LeftElbow = r(35, 0, -45), r(25)
	elseif style == "Thrust" or style == "SwordThrust" then
		pose.Waist = r(-18, released and -25 or 25)
		pose.RightShoulder, pose.RightElbow = r(released and 95 or 25, 0, 30), r(released and 0 or 100)
		pose.LeftShoulder, pose.LeftElbow = r(55, 0, -20), r(75)
		pose.RightHip, pose.LeftHip = r(released and 28 or -20), r(released and -25 or 25)
	elseif style == "Slash" or style == "SwordSlash" or style == "SwordCleave" then
		pose.Waist = r(-10, released and -side * 55 or side * 40 * charge)
		pose.RightShoulder, pose.RightElbow = r(style == "SwordCleave" and 165 or 90, released and 20 or -35, released and -40 or 55), r(released and 12 or 70)
		pose.LeftShoulder, pose.LeftElbow = r(55, 0, -20), r(65)
	elseif style == "Spin" then
		pose.Root = r(0, released and age * 700 or -30, 0)
		pose.Waist, pose.RightShoulder, pose.LeftShoulder = r(-8), r(80, 0, 55), r(60, 0, -65)
		pose.RightElbow, pose.LeftElbow = r(15), r(40)
	elseif style == "Bind" then
		pose.RightShoulder, pose.LeftShoulder = r(90, -15 - nuance, -10), r(90, 15 + nuance, 10)
		pose.RightElbow, pose.LeftElbow = r(released and 5 or 70), r(released and 5 or 70)
	elseif style == "Barrage" then
		pose.RightShoulder, pose.LeftShoulder = r(115, 0, 25), r(100 + math.sin(age * 18) * 15, 0, -25)
		pose.RightElbow, pose.LeftElbow = r(30), r(40)
	elseif style == "Teleport" then
		pose.Waist = r(-12, age * 220)
		pose.RightShoulder, pose.LeftShoulder = r(55, 25, -45), r(55, -25, 45)
		pose.RightElbow, pose.LeftElbow = r(100), r(100)
	elseif style == "Parry" then
		pose.RightShoulder, pose.LeftShoulder = r(80, 0, -30), r(70, 0, 20)
		pose.RightElbow, pose.LeftElbow = r(90), r(80)
		pose.Waist = r(-8, 25)
	elseif style == "Ascend" then
		pose.RightShoulder, pose.LeftShoulder = r(145, 0, 30), r(110, 0, -45)
		pose.RightHip, pose.LeftHip, pose.RightKnee = r(35), r(-15), r(-50)
	end
	return pose
end
function Animation:GetPose(character, now)
	local transformation = character:GetAttribute("TransformStart") or 0
	if character:GetAttribute("Awakened") and transformation > 0 and now - transformation < Config.TransformTime then
		local t = math.clamp((now - transformation) / Config.TransformTime, 0, 1)
		local id = character:GetAttribute("MagicId")
		local folded = { Waist = r(-20), Neck = r(10), RightShoulder = r(55, 20, -35), LeftShoulder = r(55, -20, 35), RightElbow = r(100), LeftElbow = r(100), RightHip = r(15), LeftHip = r(15), RightKnee = r(-25), LeftKnee = r(-25) }
		local opened = { Waist = r(8), Neck = r(-10), RightShoulder = r(id == "Anti" and 165 or 75, 0, 70), LeftShoulder = r(id == "Water" and 135 or 75, 0, -70), RightElbow = r(20), LeftElbow = r(20) }
		return blend(folded, opened, math.clamp((t - .3) / .5, 0, 1))
	end
	local spell = Spells.All[character:GetAttribute("CastSpell") or ""]
	if spell and now < (character:GetAttribute("CastEnd") or 0) then
		local age = now - (character:GetAttribute("CastStart") or now)
		local charge = math.clamp(age / math.max(.01, spell.CastTime), 0, 1)
		return casting(spell, charge, age >= spell.CastTime, age)
	end
	return nil
end
function Animation:Melee(character, index, age)
	local profile = character:GetAttribute("MeleeProfile")
	local definition = Core.Combat.Attacks[index]
	if profile == nil or profile == "Fist" or not definition or age < 0 or age > definition.Recovery then return nil end
	local style = profile == "Spear" and "Thrust" or (index == 4 and "SwordCleave" or "SwordSlash")
	local spell = { Style = style, Flavor = index }
	local pose = casting(spell, math.clamp(age / definition.Windup, 0, 1), age >= definition.Windup, age)
	if profile == "Spear" and index % 2 == 0 then pose.Waist = r(-12, index == 4 and 50 or -40) end
	local fade = math.clamp((age - definition.Windup - definition.Active) / math.max(.01, definition.Recovery - definition.Windup - definition.Active), 0, 1)
	return blend(pose, {}, fade)
end
function Animation:Stance(character, pose, speed, now)
	local profile = character:GetAttribute("MeleeProfile")
	if profile == "Sword" then
		pose.RightShoulder, pose.RightElbow = r(speed > 18 and -25 or 5, 15, 30), r(25)
		pose.Waist = pose.Waist * r(-4, -5)
	elseif profile == "Spear" or profile == "WindWeapon" then
		pose.RightShoulder, pose.RightElbow = r(15, 0, 22), r(35)
	end
	if (character:GetAttribute("FlightUntil") or 0) > now then
		pose.Waist, pose.RightHip, pose.LeftHip = r(-20), r(12), r(-20)
		pose.RightKnee, pose.LeftKnee, pose.LeftShoulder = r(-25), r(-25), r(-15, 0, -45)
	end
	return pose
end
return Animation
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1364">
          <Properties>
            <string name="Name">MagicArt</string>
            <string name="Source"><![CDATA[--!nonstrict
local package = game:GetService("ReplicatedStorage"):WaitForChild("BlackClover")
local Config = require(package.Shared.MagicConfig)
local Geometry = require(script.Parent.MagicGeometry)
local Art = { Parts = 0, TemplateCounts = {} }
function Art:Track(model)
	local count = 0
	for _, part in model:GetDescendants() do if part:IsA("BasePart") then count += 1 end end
	if self.Parts + count > Config.Limits.VFXParts then model:Destroy(); return nil end
	self.Parts += count
	model.Destroying:Connect(function() self.Parts -= count end)
	return model
end
function Art:Clone(name, scale)
	local originals = package:WaitForChild("ArtTemplates")
	local template = originals:FindFirstChild(name)
	if not template then return nil end
	local imported = package:WaitForChild("ArtMeshes"):FindFirstChild(name)
	if not imported then
		if not self.TemplateCounts[name] then
			local count = 0
			for _, part in template:GetDescendants() do if part:IsA("BasePart") then count += 1 end end
			self.TemplateCounts[name] = count
		end
		if self.Parts + self.TemplateCounts[name] > Config.Limits.VFXParts then return nil end
	end
	local model
	if imported and (imported:IsA("Model") or imported:IsA("BasePart")) then
		local geometry = imported:Clone()
		model = Geometry.Model(name)
		geometry.Parent = model
		if geometry:IsA("Model") then
			local expectedCF, expectedSize = template:GetBoundingBox()
			local _, actualSize = geometry:GetBoundingBox()
			geometry:ScaleTo(geometry:GetScale() * expectedSize.Magnitude / math.max(.01, actualSize.Magnitude))
			local actualCF = geometry:GetBoundingBox()
			geometry:PivotTo(CFrame.new(expectedCF.Position - actualCF.Position) * geometry:GetPivot())
		else
			local expectedCF, expectedSize = template:GetBoundingBox()
			geometry.Size, geometry.CFrame = expectedSize, expectedCF
		end
	else model = template:Clone() end
	for _, item in model:GetDescendants() do
		if item:IsA("LuaSourceContainer") or item:IsA("JointInstance") or item:IsA("Constraint") or item:IsA("Humanoid")
			or item:IsA("Sound") or item:IsA("ParticleEmitter") then item:Destroy()
		elseif item:IsA("BasePart") then
			item.Anchored, item.CanCollide, item.CanTouch, item.CanQuery, item.Massless = true, false, false, false, true
		end
	end
	if scale and scale ~= 1 then model:ScaleTo(scale) end
	return self:Track(model)
end
function Art:Attach(model, body, offset, animated)
	if not model or not body then return nil end
	local root = model.PrimaryPart
	model:PivotTo(body.CFrame * offset)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			part.Anchored, part.Massless = false, true
			if part ~= root then
				local weld = Instance.new("WeldConstraint")
				weld.Part0, weld.Part1, weld.Parent = root, part, part
			end
		end
	end
	if animated then
		local motor = Instance.new("Motor6D")
		motor.Name = "MagicWingHinge"
		motor.Part0, motor.Part1, motor.C0 = body, root, offset
		motor.Parent = root
		return motor
	end
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = body, root, root
	return weld
end
function Art:Color(element, accent)
	local data = Config.Classes[element] or Config.Classes.Water
	local c = accent and data.Accent or data.Color
	return Color3.fromRGB(c[1], c[2], c[3])
end
return Art
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1365">
          <Properties>
            <string name="Name">MagicEquipment</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local shared = game:GetService("ReplicatedStorage").BlackClover.Shared
local Config, Spells = require(shared.MagicConfig), require(shared.SpellRegistry)
local Core = require(shared.Config)
local Art = require(script.Parent.MagicArt)
local Geometry = require(script.Parent.MagicGeometry)
local Books = require(script.Parent.GrimoireManager)
local Equipment = { Actors = {} }
local bodies = { "UpperTorso", "LowerTorso", "Head", "LeftUpperArm", "RightUpperArm", "LeftLowerLeg", "RightLowerLeg" }
local function reveal(model, alpha)
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part.Name ~= "Root" then
			local original = part:GetAttribute("OriginalTransparency")
			if original == nil then original = part.Transparency; part:SetAttribute("OriginalTransparency", original) end
			part.Transparency = 1 - (1 - original) * alpha
		end
	end
end
function Equipment:ClearArmor(entry)
	for _, model in entry.Armor or {} do model:Destroy() end
	entry.Armor, entry.Wings = {}, {}
	for part, color in entry.Colors or {} do if part.Parent then part.Color = color end end
	entry.Colors = {}
end
function Equipment:Remove(character)
	local entry = self.Actors[character]
	if not entry then return end
	self:ClearArmor(entry)
	if entry.Book then entry.Book.Model:Destroy() end
	if entry.Weapon then entry.Weapon:Destroy() end
	if entry.Shield then entry.Shield:Destroy() end
	self.Actors[character] = nil
end
function Equipment:Weapon(entry, character, desired)
	if entry.WeaponName == desired then return end
	if entry.Weapon then entry.Weapon:Destroy(); entry.Weapon = nil end
	entry.WeaponName = desired
	if desired == "" then return end
	local hand = character:FindFirstChild("RightHand")
	local model = hand and Art:Clone(desired)
	if not model then entry.WeaponName = nil; return end
	model.Parent, entry.Weapon = self.Folder, model
	Art:Attach(model, hand, CFrame.new(0, -.05, -.05) * CFrame.Angles(0, 0, math.rad(-30)), false)
	local a, b = Instance.new("Attachment"), Instance.new("Attachment")
	a.Position, b.Position = Vector3.new(0, 1, 0), Vector3.new(0, desired == "AntiSword" and 6 or 5.2, 0)
	a.Parent, b.Parent = model.PrimaryPart, model.PrimaryPart
	local trail = Instance.new("Trail")
	trail.Attachment0, trail.Attachment1, trail.Lifetime = a, b, .17
	trail.FaceCamera, trail.LightEmission = true, .8
	trail.Color = ColorSequence.new(Art:Color(entry.Magic), Art:Color(entry.Magic, true))
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, .15), NumberSequenceKeypoint.new(1, 1) })
	trail.Enabled, trail.Parent = false, model.PrimaryPart
	entry.Trail = trail
end
function Equipment:Armor(entry, character)
	self:ClearArmor(entry)
	local id = entry.Magic
	for _, name in bodies do
		local body = character:FindFirstChild(name)
		local model = body and Art:Clone(id .. "Armor" .. name)
		if model then model.Parent = self.Folder; Art:Attach(model, body, CFrame.identity, false); table.insert(entry.Armor, model) end
	end
	local torso = character:FindFirstChild("UpperTorso")
	if torso then
		for _, side in { -1, 1 } do
			local model = Art:Clone(id .. "Wing" .. (side == -1 and "Left" or "Right"))
			if model then
				model.Parent = self.Folder
				local motor = Art:Attach(model, torso, CFrame.new(side * .3, .3, .7), true)
				table.insert(entry.Armor, model)
				table.insert(entry.Wings, { Motor = motor, Side = side })
			end
		end
	end
	if id == "Bone" or id == "Anti" then
		for _, part in character:GetChildren() do
			if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
				entry.Colors[part] = part.Color
				part.Color = id == "Bone" and part.Name == "Head" and Color3.fromRGB(104, 99, 105) or Color3.fromRGB(25, 24, 33)
			end
		end
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local aura = root and Art:Track(Geometry.Circle(id == "Wind" and 7 or 4, Art:Color(id)))
	if aura then
		aura.Parent = self.Folder
		local offset = id == "Wind" and CFrame.new(0, 1, 2) * CFrame.Angles(math.pi / 2, 0, 0) or CFrame.new(0, -2.95, 0)
		local motor = Art:Attach(aura, root, offset, true)
		table.insert(entry.Armor, aura)
		entry.AuraMotor = motor
	end
end
function Equipment:Shield(entry, character, visual)
	if entry.ShieldName == visual then return end
	if entry.Shield then entry.Shield:Destroy(); entry.Shield = nil end
	entry.ShieldName = visual
	if visual == "" then return end
	local body = character:FindFirstChild("UpperTorso")
	if not body then return end
	local model = Geometry.Model(visual)
	local color = Art:Color(visual == "IceShield" and "Ice" or "Water")
	if visual == "IceShield" then
		for i = 1, 6 do
			local angle = i * math.pi / 3
			Geometry.Crystal(model, Vector3.new(math.cos(angle) * 3, -.5, math.sin(angle) * 3), 5.5, color)
		end
		Geometry.Ring(model, 3.6, 0, color, 12)
	else
		local dome = Geometry.Part(model, "WaterVolume", Vector3.new(10, 10, 10), CFrame.new(0, -1, 0), color, Enum.Material.Glass, "Ball")
		dome.Transparency = .86
		for i = -1, 1 do Geometry.Ring(model, 4.4 - math.abs(i) * .4, i * 2 - 1, color, 16, .075) end
	end
	if not Art:Track(model) then entry.ShieldName = nil; return end
	model.Parent, entry.Shield = self.Folder, model
	entry.ShieldMotor = Art:Attach(model, body, CFrame.identity, true)
	if visual == "WaterDome" then
		for _, sign in { -1, 1 } do
			local dragon = Art:Clone("Dragon", .3)
			if dragon then dragon.Parent = model; Art:Attach(dragon, model.PrimaryPart, CFrame.new(sign * 4, -.5, 0) * CFrame.Angles(0, sign * math.pi / 2, 0), false) end
		end
	end
end
function Equipment:Step(character, dt, now)
	local root, humanoid = character:FindFirstChild("HumanoidRootPart"), character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid then return end
	local camera = workspace.CurrentCamera
	local tooFar = camera and (camera.CFrame.Position - root.Position).Magnitude > 115 and character ~= Players.LocalPlayer.Character
	local id = character:GetAttribute("MagicId") or ""
	if tooFar or humanoid.Health <= 0 or not Config.Classes[id] then self:Remove(character); return end
	local entry = self.Actors[character]
	if entry and entry.Magic ~= id then self:Remove(character); entry = nil end
	if not entry then entry = { Magic = id, Armor = {}, Wings = {}, Colors = {} }; self.Actors[character] = entry end
	if not entry.Book and now >= (entry.BookRetry or 0) then entry.Book = Books:Create(id, self.Folder); entry.BookRetry = now + 1 end
	if entry.Book then Books:Step(entry.Book, character, dt, now) end
	local awakened = character:GetAttribute("Awakened") == true
	if entry.Awakened ~= awakened then
		entry.Awakened = awakened
		if awakened then self:Armor(entry, character) else self:ClearArmor(entry) end
	end
	local weapon = id == "Anti" and "AntiSword" or (awakened and id == "Water" and "WaterSpear" or (awakened and id == "Wind" and "WindWeapon" or ""))
	if weapon == "" and (character:GetAttribute("WeaponUntil") or 0) > now then weapon = character:GetAttribute("WeaponOverride") or "" end
	self:Weapon(entry, character, weapon)
	local castId = character:GetAttribute("CastSpell") or ""
	local spell = Spells.All[castId]
	if entry.Weapon and weapon == "AntiSword" then
		local scale = castId == "Anti_AV" and 1.55 or (awakened and 1.12 or 1)
		if entry.WeaponScale ~= scale then entry.Weapon:ScaleTo(scale); entry.WeaponScale = scale end
	end
	if entry.Trail and entry.Trail.Parent then
		local definition = Core.Combat.Attacks[character:GetAttribute("AttackIndex") or 0]
		local age = now - (character:GetAttribute("AttackStart") or 0)
		entry.Trail.Enabled = (definition and age >= definition.Windup * .5 and age < definition.Windup + definition.Active)
			or (spell and (spell.Kind == "Spin" or spell.Kind == "DashStrike")) or false
	end
	local elapsed = now - (character:GetAttribute("TransformStart") or 0)
	if awakened then
		for i, model in entry.Armor do reveal(model, math.clamp((elapsed - i * .08) / .7, 0, 1)) end
		local opened = math.clamp((elapsed - .75) / 1.1, 0, 1)
		for _, wing in entry.Wings do
			wing.Motor.Transform = CFrame.Angles(0, -wing.Side * ((1 - opened) * 1.25 + .12), wing.Side * math.sin(now * 2.8) * .15 * opened)
		end
		if entry.AuraMotor and entry.AuraMotor.Parent then entry.AuraMotor.Transform = CFrame.Angles(0, now * .4, 0) end
	end
	self:Shield(entry, character, character:GetAttribute("ShieldVisual") or "")
	if entry.ShieldMotor and entry.ShieldMotor.Parent then entry.ShieldMotor.Transform = CFrame.Angles(0, now * .8, 0) end
end
function Equipment:Start()
	self.Folder = Instance.new("Folder")
	self.Folder.Name, self.Folder.Parent = "LocalMagicEquipment", workspace
	CollectionService:GetInstanceRemovedSignal("BCActor"):Connect(function(character) self:Remove(character) end)
	RunService.PreSimulation:Connect(function(dt)
		local now = workspace:GetServerTimeNow()
		local own = Players.LocalPlayer.Character
		if own then self:Step(own, dt, now) end
		for _, actor in CollectionService:GetTagged("BCActor") do if actor ~= own then self:Step(actor, dt, now) end end
	end)
end
return Equipment
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1366">
          <Properties>
            <string name="Name">MagicGeometry</string>
            <string name="Source"><![CDATA[--!nonstrict
local Geometry = {}
function Geometry.Part(parent, name, size, cframe, color, material, shape)
	local part = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	part.Name, part.Size, part.CFrame = name, size, cframe
	part.Color, part.Material = color, material or Enum.Material.SmoothPlastic
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery, part.CastShadow = true, false, false, false, false
	if shape == "Ball" then part.Shape = Enum.PartType.Ball elseif shape == "Cylinder" then part.Shape = Enum.PartType.Cylinder end
	part.Parent = parent
	return part
end
function Geometry.Model(name)
	local model = Instance.new("Model")
	model.Name = name
	local root = Geometry.Part(model, "Root", Vector3.one * .1, CFrame.identity, Color3.new())
	root.Transparency = 1
	model.PrimaryPart = root
	return model
end
function Geometry.Rod(parent, a, b, radius, color, neon)
	local delta = b - a
	if delta.Magnitude < .01 then return nil end
	return Geometry.Part(parent, "Flow", Vector3.new(radius * 2, radius * 2, delta.Magnitude),
		CFrame.lookAt((a + b) / 2, b), color, neon and Enum.Material.Neon or Enum.Material.SmoothPlastic)
end
function Geometry.Ring(parent, radius, y, color, segments, thickness)
	segments = segments or 20
	for i = 1, segments do
		local a, b = i * math.pi * 2 / segments, (i + 1) * math.pi * 2 / segments
		Geometry.Rod(parent, Vector3.new(math.cos(a) * radius, y, math.sin(a) * radius),
			Vector3.new(math.cos(b) * radius, y, math.sin(b) * radius), thickness or .055, color, true)
	end
end
function Geometry.Circle(radius, color)
	local model = Geometry.Model("MagicCircle")
	Geometry.Ring(model, radius, 0, color, 20)
	Geometry.Ring(model, radius * .76, 0, color, 12, .035)
	for i = 1, 5 do
		local a, b = i * math.pi * 2 / 5, (i + 2) * math.pi * 2 / 5
		Geometry.Rod(model, Vector3.new(math.cos(a), 0, math.sin(a)) * radius * .65,
			Vector3.new(math.cos(b), 0, math.sin(b)) * radius * .65, .035, color, true)
	end
	return model
end
function Geometry.Crystal(parent, position, height, color)
	for i = 1, 4 do
		local part = Geometry.Part(parent, "Crystal", Vector3.new(height * .35, height, height * .35),
			CFrame.new(position) * CFrame.Angles(0, i * math.pi / 2, math.pi), color, Enum.Material.Glass, "Wedge")
		part.Transparency = .17
	end
end
function Geometry.Bone(parent, position, height, color)
	Geometry.Part(parent, "BoneShaft", Vector3.new(height, height * .14, height * .14),
		CFrame.new(position) * CFrame.Angles(0, 0, math.pi / 2), color, nil, "Cylinder")
	Geometry.Part(parent, "BoneJoint", Vector3.one * height * .23, CFrame.new(position - Vector3.new(0, height * .42, 0)), color, nil, "Ball")
	Geometry.Part(parent, "BoneTip", Vector3.new(height * .2, height * .4, height * .2),
		CFrame.new(position + Vector3.new(0, height * .5, 0)) * CFrame.Angles(0, 0, math.pi), color, nil, "Wedge")
end
function Geometry.Star(parent, position, size, color)
	for i = 1, 5 do
		Geometry.Part(parent, "StarRay", Vector3.new(size * .45, size, size * .15),
			CFrame.new(position) * CFrame.Angles(0, 0, i * math.pi * 2 / 5) * CFrame.new(0, size * .28, 0), color, Enum.Material.Neon, "Wedge")
	end
end
function Geometry.Arc(radius, color, dark)
	local model = Geometry.Model("CuttingArc")
	for i = 0, 11 do
		local a = -.5 * math.pi + i * math.pi / 12
		local b = -.5 * math.pi + (i + 1) * math.pi / 12
		local p = Vector3.new(math.sin(a) * radius, math.cos(a) * radius * .35, 0)
		local q = Vector3.new(math.sin(b) * radius, math.cos(b) * radius * .35, 0)
		Geometry.Rod(model, p, q, dark and .18 or .1, color, true)
		if dark then Geometry.Rod(model, p + Vector3.new(0, -.2, .15), q + Vector3.new(0, -.2, .15), .28, Color3.fromRGB(22, 13, 30), false) end
	end
	return model
end
function Geometry.Beam(parent, a, b, color, width)
	local pa = Geometry.Part(parent, "BeamEnd", Vector3.one * .1, CFrame.new(a), color)
	local pb = Geometry.Part(parent, "BeamEnd", Vector3.one * .1, CFrame.new(b), color)
	pa.Transparency, pb.Transparency = 1, 1
	local aa, ab = Instance.new("Attachment"), Instance.new("Attachment")
	aa.Parent, ab.Parent = pa, pb
	local beam = Instance.new("Beam")
	beam.Attachment0, beam.Attachment1 = aa, ab
	beam.Width0, beam.Width1, beam.FaceCamera = width or .1, width or .1, true
	beam.Color, beam.LightEmission = ColorSequence.new(color), .9
	beam.Parent = pa
	return beam
end
return Geometry
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1367">
          <Properties>
            <string name="Name">MagicHUD</string>
            <string name="Source"><![CDATA[--!nonstrict
local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local shared = game:GetService("ReplicatedStorage").BlackClover.Shared
local Config, Spells = require(shared.MagicConfig), require(shared.SpellRegistry)
local Art = require(script.Parent.MagicArt)
local UI = { Cards = {}, LastFlight = 0 }
local function object(class, parent, props)
	local item = Instance.new(class)
	for key, value in props do item[key] = value end
	item.Parent = parent
	return item
end
local function text(parent, value, position, size, fontSize, color)
	return object("TextLabel", parent, { Text = value, Position = position, Size = size, BackgroundTransparency = 1,
		TextColor3 = color or Color3.fromRGB(228, 237, 236), Font = Enum.Font.GothamMedium, TextSize = fontSize,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left })
end
local function panel(parent, position, size, anchor, button)
	local frame = object(button and "TextButton" or "Frame", parent, { Position = position, Size = size,
		AnchorPoint = anchor or Vector2.zero, BackgroundColor3 = Color3.fromRGB(12, 22, 31), BackgroundTransparency = .08, BorderSizePixel = 0 })
	if button then frame.Text = ""; frame.AutoButtonColor = true end
	object("UICorner", frame, { CornerRadius = UDim.new(0, 9) })
	object("UIStroke", frame, { Color = Color3.fromRGB(83, 111, 117), Transparency = .25 })
	return frame
end
function UI:Notice(message)
	self.Toast.Text, self.ToastUntil = message, os.clock() + 3
end
function UI:Cast(slot)
	local character = Players.LocalPlayer.Character
	if not character or self.Menu.Visible then return end
	local spell = Spells.Get(character:GetAttribute("MagicId"), character:GetAttribute("Awakened"), slot)
	if not spell then self:Notice("Сначала выберите магию: M"); return end
	local now = workspace:GetServerTimeNow()
	local recall = spell.Kind == "Summon" and character:GetAttribute("HasGolem")
	if not recall and (character:GetAttribute("Mana") or 0) < spell.ManaCost then self:Notice("Недостаточно маны"); return end
	if not recall and (character:GetAttribute("CD_" .. spell.Id) or 0) > now then self:Notice("Способность восстанавливается"); return end
	self.Action:FireServer("Cast", { Slot = slot, Point = self.Mouse.Hit.Position })
end
function UI:Awakening()
	local character = Players.LocalPlayer.Character
	local class = character and Config.Classes[character:GetAttribute("MagicId")]
	if not class or class.Drain <= 0 then self:Notice("Пробуждение есть у Воды, Ветра, Костей и Антимагии"); return end
	self.Action:FireServer("Awakening")
end
function UI:FlightDirection()
	local camera = workspace.CurrentCamera
	if not camera then return Vector3.zero end
	local direction = Vector3.zero
	if Input:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
	if Input:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
	if Input:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
	if Input:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
	if Input:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
	if Input:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end
	return direction.Magnitude > 1 and direction.Unit or direction
end
function UI:StopFlight()
	self.WantsFlight = false
	self.Action:FireServer("Flight", { Active = false })
end
function UI:Start(parent, action, remotes)
	self.Action, self.Mouse = action, Players.LocalPlayer:GetMouse()
	local choose = panel(parent, UDim2.new(1, -24, 0, 18), UDim2.fromOffset(225, 58), Vector2.new(1, 0), true)
	self.Selected = text(choose, "M  ВЫБРАТЬ МАГИЮ", UDim2.fromOffset(16, 8), UDim2.fromOffset(195, 22), 12)
	text(choose, "Гримуар · способности · пробуждение", UDim2.fromOffset(16, 32), UDim2.fromOffset(195, 17), 9, Color3.fromRGB(158, 180, 183))
	self.Menu = panel(parent, UDim2.fromScale(.5, .43), UDim2.fromOffset(730, 400), Vector2.new(.5, .5))
	self.Menu.Visible = false
	self.Menu.ZIndex = 20
	text(self.Menu, "ВЫБЕРИТЕ СВОЙ ГРИМУАР", UDim2.fromOffset(24, 18), UDim2.fromOffset(650, 32), 20)
	text(self.Menu, "Смена магии сохраняет ману и перезарядки.  M — закрыть", UDim2.fromOffset(24, 52), UDim2.fromOffset(650, 24), 11, Color3.fromRGB(163, 185, 185))
	for i, id in Config.Order do
		local column, row = (i - 1) % 4, math.floor((i - 1) / 4)
		local card = panel(self.Menu, UDim2.fromOffset(24 + column * 174, 95 + row * 137), UDim2.fromOffset(162, 122), nil, true)
		card.ZIndex = 21
		local class = Config.Classes[id]
		local title = text(card, class.Name, UDim2.fromOffset(12, 8), UDim2.fromOffset(140, 27), 17, Art:Color(id))
		title.ZIndex = 22
		local passive = text(card, class.Passive, UDim2.fromOffset(12, 40), UDim2.fromOffset(138, 44), 11)
		passive.ZIndex = 22
		local description = text(card, class.Drain > 0 and ("G · −" .. class.Drain .. " маны/с") or "4 базовых заклинания", UDim2.fromOffset(12, 91), UDim2.fromOffset(140, 20), 10, Color3.fromRGB(176, 194, 190))
		description.ZIndex = 22
		card.Activated:Connect(function() self.Action:FireServer("SelectMagic", id); self.Menu.Visible = false end)
	end
	choose.Activated:Connect(function() self.Menu.Visible = not self.Menu.Visible end)
	local strip = panel(parent, UDim2.new(.5, 0, 1, -130), UDim2.fromOffset(560, 85), Vector2.new(.5, 1))
	for i, slot in { "Z", "X", "C", "V" } do
		local card = panel(strip, UDim2.fromOffset(8 + (i - 1) * 108, 7), UDim2.fromOffset(102, 71), nil, true)
		local key = text(card, slot, UDim2.fromOffset(9, 4), UDim2.fromOffset(21, 20), 16)
		local cost = text(card, "", UDim2.fromOffset(35, 4), UDim2.fromOffset(60, 20), 10)
		local name = text(card, "Выберите магию", UDim2.fromOffset(9, 27), UDim2.fromOffset(88, 34), 10)
		self.Cards[slot] = { Frame = card, Key = key, Cost = cost, Name = name }
		card.Activated:Connect(function() self:Cast(slot) end)
	end
	local awakening = panel(strip, UDim2.fromOffset(442, 7), UDim2.fromOffset(110, 71), nil, true)
	self.AwakeningText = text(awakening, "G\nПРОБУЖДЕНИЕ", UDim2.fromOffset(8, 5), UDim2.fromOffset(94, 60), 11)
	awakening.Activated:Connect(function() self:Awakening() end)
	self.Toast = text(parent, "", UDim2.new(.5, 0, .16, 0), UDim2.fromOffset(620, 44), 15, Color3.fromRGB(248, 212, 143))
	self.Toast.AnchorPoint, self.Toast.TextXAlignment = Vector2.new(.5, 0), Enum.TextXAlignment.Center
	self.Toast.TextStrokeTransparency = .5
	Input.InputBegan:Connect(function(input, processed)
		if processed or Input:GetFocusedTextBox() then return end
		local key = input.KeyCode.Name
		if key == "M" then self.Menu.Visible = not self.Menu.Visible; return end
		if self.Menu.Visible then return end
		if self.Cards[key] then self:Cast(key)
		elseif key == "G" then self:Awakening()
		elseif key == "R" then
			if self.WantsFlight then self:StopFlight()
			else self.WantsFlight = true; self.FlightRequested = workspace:GetServerTimeNow(); self.Action:FireServer("Flight", { Active = true, Direction = self:FlightDirection() }) end
		end
	end)
	Input.WindowFocusReleased:Connect(function() self:StopFlight() end)
	Input.TextBoxFocused:Connect(function() self:StopFlight() end)
	Players.LocalPlayer.CharacterAdded:Connect(function() self:StopFlight(); self.OpenedFor = nil end)
	remotes.MagicFX.OnClientEvent:Connect(function(kind, message) if kind == "Notice" then self:Notice(message) end end)
	remotes.FX.OnClientEvent:Connect(function(kind, rejected)
		if kind ~= "Rejected" then return end
		if rejected == "Flight" then self.WantsFlight = false; self:Notice("Полёт доступен в пробуждении Ветра и Антимагии: до 4 с, R")
		elseif rejected == "Cast" or rejected == "Awakening" or rejected == "SelectMagic" then self:Notice("Действие недоступно: проверьте ману, перезарядку и состояние персонажа") end
	end)
	RunService.RenderStepped:Connect(function() self:Step() end)
end
function UI:Step()
	local character = Players.LocalPlayer.Character
	if not character then return end
	local id = character:GetAttribute("MagicId") or ""
	local class = Config.Classes[id]
	local now, awakened = workspace:GetServerTimeNow(), character:GetAttribute("Awakened") == true
	if not class and self.OpenedFor ~= character then self.Menu.Visible = true; self.OpenedFor = character end
	self.Selected.Text = "M  " .. (class and string.upper(class.Name) or "ВЫБРАТЬ МАГИЮ")
	for slot, card in self.Cards do
		local spell = Spells.Get(id, awakened, slot)
		card.Frame.UIStroke.Color = class and Art:Color(id) or Color3.fromRGB(83, 111, 117)
		if spell then
			local remaining = math.max(0, (character:GetAttribute("CD_" .. spell.Id) or 0) - now)
			local recall = spell.Kind == "Summon" and character:GetAttribute("HasGolem")
			card.Name.Text = recall and "Отозвать голема" or spell.Name
			card.Cost.Text = recall and "ОТОЗВАТЬ" or (remaining > 0 and string.format("%.1f с", remaining) or (tostring(spell.ManaCost) .. " маны"))
			card.Key.TextColor3 = remaining > 0 and Color3.fromRGB(112, 131, 139) or Art:Color(id)
		end
	end
	self.AwakeningText.Text = awakened and class and ("G · ОТКЛЮЧИТЬ\n−" .. class.Drain .. " маны/с")
		or (class and class.Drain > 0 and "G\nПРОБУЖДЕНИЕ" or "G\n—")
	self.AwakeningText.TextColor3 = class and Art:Color(id) or Color3.fromRGB(112, 131, 139)
	self.Toast.Visible = os.clock() < (self.ToastUntil or 0)
	if self.WantsFlight then
		local untilTime = character:GetAttribute("FlightUntil") or 0
		if now > (self.FlightRequested or 0) + .65 and untilTime <= now then self.WantsFlight = false
		elseif now - self.LastFlight >= .1 then
			self.LastFlight = now
			self.Action:FireServer("Flight", { Active = true, Direction = self:FlightDirection() })
		end
	end
end
return UI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1368">
          <Properties>
            <string name="Name">MagicVFX</string>
            <string name="Source"><![CDATA[--!nonstrict
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local TweenService = game:GetService("TweenService")
local shared = game:GetService("ReplicatedStorage").BlackClover.Shared
local Config, Spells = require(shared.MagicConfig), require(shared.SpellRegistry)
local Art = require(script.Parent.MagicArt)
local G = require(script.Parent.MagicGeometry)
local VFX = { Entities = {}, Casts = {}, Pool = {}, PoolSize = 0, Retry = {} }
local function emitter(part, color, mist)
	local p = Instance.new("ParticleEmitter")
	p.Texture = mist and "rbxasset://textures/particles/smoke_main.dds" or "rbxasset://textures/particles/sparkles_main.dds"
	p.Color, p.LightEmission = ColorSequence.new(color), mist and .15 or .8
	p.Lifetime, p.Speed = NumberRange.new(.3, .7), NumberRange.new(6, 20)
	p.SpreadAngle, p.Drag = Vector2.new(180, 180), 4
	p.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, mist and 2 or .3), NumberSequenceKeypoint.new(1, 0) })
	p.Rate, p.Parent = 0, part
	return p
end
function VFX:Sound(parent, id, pitch)
	if not id or id == "" then return end
	local sound = Instance.new("Sound")
	sound.SoundId, sound.Volume, sound.PlaybackSpeed = id, .23, pitch or 1
	sound.RollOffMinDistance, sound.RollOffMaxDistance = 10, 100
	sound.Parent = parent
	sound:Play()
	Debris:AddItem(sound, 3)
end
function VFX:Pulse(kind, position, element, radius, detail)
	if typeof(position) ~= "Vector3" then return end
	local camera = workspace.CurrentCamera
	if camera and (position - camera.CFrame.Position).Magnitude > Config.Limits.VFXDistance then return end
	local slot = table.remove(self.Pool)
	if not slot then
		if self.PoolSize >= 24 then return end
		self.PoolSize += 1
		local part = G.Part(nil, "PooledImpact", Vector3.one * .1, CFrame.identity, Color3.new())
		part.Transparency = 1
		slot = { Part = part, Emitter = emitter(part, Color3.new(1, 1, 1)), Lease = 0 }
	end
	slot.Lease += 1
	local lease = slot.Lease
	slot.Part.CFrame, slot.Part.Parent = CFrame.new(position), self.Folder
	slot.Emitter.Color = ColorSequence.new(Art:Color(element), Art:Color(element, true))
	slot.Emitter.Speed = NumberRange.new(5, math.min(40, radius * 2))
	slot.Emitter:Emit(math.clamp(math.floor(radius * 2), 10, 45))
	self:Sound(slot.Part, element == "Water" and Config.Audio.Water or Config.Audio.Impact, kind == "Final" and .65 or 1.1)
	if kind == "Clash" or kind == "Final" or kind == "Teleport" then
		local circle = Art:Track(G.Circle(math.min(radius, 22), Art:Color(element)))
		if circle then
			circle:PivotTo(CFrame.new(position - Vector3.new(0, kind == "Teleport" and 2.8 or 0, 0)))
			circle.Parent = self.Folder
			for _, part in circle:GetDescendants() do if part:IsA("BasePart") and part.Name ~= "Root" then TweenService:Create(part, TweenInfo.new(.45), { Transparency = 1 }):Play() end end
			Debris:AddItem(circle, .5)
		end
	end
	if kind == "Shatter" then
		local pieces = G.Model("BreakingFragments")
		for i = 1, 9 do
			local part = G.Part(pieces, "Fragment", Vector3.new(.7, 1.2, .7), CFrame.new(position), Art:Color(element), nil, "Wedge")
			local angle = i * math.pi * 2 / 9
			TweenService:Create(part, TweenInfo.new(.6), { CFrame = CFrame.new(position + Vector3.new(math.cos(angle) * 8, -3 + i % 3, math.sin(angle) * 8)) * CFrame.Angles(i, i, 0), Transparency = 1 }):Play()
		end
		if Art:Track(pieces) then pieces.Parent = self.Folder; Debris:AddItem(pieces, .7) end
	end
	task.delay(.85, function()
		if slot.Lease ~= lease then return end
		slot.Emitter:Clear()
		for _, child in slot.Part:GetChildren() do if child:IsA("Sound") then child:Destroy() end end
		slot.Part.Parent = nil
		table.insert(self.Pool, slot)
	end)
end
local function track(model) return Art:Track(model) end
function VFX:Projectile(root, spell)
	local visual, radius, color = root:GetAttribute("Visual"), root:GetAttribute("Radius") or spell.Radius, Art:Color(spell.ElementType)
	local name = ({ Dragon = "Dragon", Hawk = "Hawk", BoneSpear = "BoneSpear", WindLance = "WindWeapon", SpearJudgment = "WaterSpear" })[visual]
	if name then
		local scale = name == "Dragon" and radius / 3 or (visual == "SpearJudgment" and 1.4 or 1)
		return Art:Clone(name, scale), name:find("Spear") or name == "WindWeapon" and true
	end
	if visual == "WindBlade" or visual == "BlackArc" or visual == "EndMagic" or visual == "BoneArc" then
		local model = G.Arc(math.max(2, radius), color, spell.ElementType == "Anti")
		if visual == "BoneArc" then for i = -2, 2 do G.Bone(model, Vector3.new(i * radius * .35, .4, 0), radius * .6, color) end end
		return track(model), false
	end
	local model = G.Model(visual)
	if visual == "WaterOrb" then
		local core = G.Part(model, "WaterCore", Vector3.one * radius * 1.7, CFrame.identity, color, Enum.Material.Glass, "Ball")
		core.Transparency = .27
		G.Ring(model, radius, 0, Art:Color("Water", true), 12, .08)
		G.Ring(model, radius * .8, radius * .4, color, 10, .065)
	elseif visual == "IceDisc" then
		local disc = G.Part(model, "CrystalDisc", Vector3.new(.25, radius * 2, radius * 2), CFrame.Angles(0, math.pi / 2, 0), color, Enum.Material.Glass, "Cylinder")
		disc.Transparency = .18
		for i = 1, 6 do local a = i * math.pi / 3; G.Crystal(model, Vector3.new(math.cos(a) * radius * .7, math.sin(a) * radius * .7, 0), radius * .5, color) end
	else
		G.Star(model, Vector3.zero, visual == "StarMeteor" and 2.5 or 1.3, Art:Color("Stars", true))
		local core = G.Part(model, "AstralCore", Vector3.one * (visual == "StarMeteor" and 3 or 1), CFrame.identity, color, Enum.Material.Neon, "Ball")
		core.Transparency = .2
	end
	return track(model), false
end
function VFX:Zone(root, spell)
	local kind, visual, radius, color = root:GetAttribute("EntityKind"), spell.Visual, spell.Radius, Art:Color(spell.ElementType)
	if kind == "Hand" then return Art:Clone("BoneHand", 1.5) end
	local model = G.Model(visual)
	if kind == "Wall" then
		for x = -2.5, 2.5, 1 do
			for y = -1, 1 do G.Part(model, "StoneBlock", Vector3.new(2.9, 3.9, 3.1), CFrame.new(x * 3, y * 4, .08 * (y % 2)) * CFrame.Angles(0, 0, .015 * y), color:Lerp(Color3.fromRGB(95, 91, 79), .45), Enum.Material.Slate, "Wedge") end
		end
	elseif kind == "Tornado" then
		for strand = 0, 1 do
			for i = 0, 23 do
				local a, b = i / 24, (i + 1) / 24
				local function point(t)
					local angle = t * math.pi * 5 + strand * math.pi
					local r = 1.5 + t * (radius - 1.5)
					return Vector3.new(math.cos(angle) * r, t * 20 - 2, math.sin(angle) * r)
				end
				local part = G.Rod(model, point(a), point(b), .15 + a * .1, strand == 0 and color or Art:Color("Wind", true), true)
				part.Transparency = .25
			end
		end
	elseif kind == "Spike" then
		for i = -1, 1 do
			if spell.ElementType == "Bone" then G.Bone(model, Vector3.new(i * 1.5, 3, 0), 6 - math.abs(i), color)
			else G.Crystal(model, Vector3.new(i * 1.4, 3, 0), 7 - math.abs(i), color) end
		end
	elseif kind == "Prison" then
		local count = visual == "BoneGrave" and 12 or (visual == "StarPrison" and 6 or 8)
		local height = visual == "BoneGrave" and 16 or 9
		local points = {}
		for i = 1, count do
			local a = i * math.pi * 2 / count
			local position = Vector3.new(math.cos(a) * radius * .78, height / 2, math.sin(a) * radius * .78)
			points[i] = position
			if spell.ElementType == "Bone" then G.Bone(model, position, height, color)
			elseif spell.ElementType == "Stars" then G.Star(model, position, 1, Art:Color("Stars", true))
			else G.Crystal(model, position, height, color) end
		end
		if spell.ElementType == "Stars" then
			for i = 1, count do
				G.Beam(model, points[i], points[i % count + 1], color, .15)
				G.Beam(model, points[i] - Vector3.new(0, 3.8, 0), points[i] + Vector3.new(0, 3.8, 0), color, .1)
			end
		else G.Ring(model, radius * .78, height * .7, color, 16, .15) end
	elseif kind == "Spin" then
		G.Ring(model, radius * .85, 0, color, 24, .15)
		G.Ring(model, radius * .62, .6, Art:Color(spell.ElementType, true), 16, .1)
		if spell.ElementType == "Water" then
			for i = 1, 6 do
				local a = i * math.pi / 3
				G.Rod(model, Vector3.new(math.cos(a) * 6, 0, math.sin(a) * 6), Vector3.new(math.cos(a) * 13, 0, math.sin(a) * 13), .12, color, true)
			end
		end
	else
		G.Ring(model, radius, -1, color, 28, .07)
		if visual == "Blizzard" then
			local ground = G.Part(model, "FrozenGround", Vector3.new(.04, radius * 2, radius * 2), CFrame.new(0, -.94, 0) * CFrame.Angles(0, 0, math.pi / 2), color, Enum.Material.Glass, "Cylinder")
			ground.Transparency = .55
			for i = 1, 6 do local a = i * math.pi / 3; G.Crystal(model, Vector3.new(math.cos(a) * radius * .7, 2, math.sin(a) * radius * .7), 4, color) end
			local mist = emitter(model.PrimaryPart, color, true)
			mist.Rate, mist.Speed, mist.Lifetime = 18, NumberRange.new(6, 15), NumberRange.new(1, 2)
			mist.Size = NumberSequence.new(5)
		elseif visual == "SkyStorm" then
			G.Ring(model, radius * .8, 22, color, 20, .15)
			G.Ring(model, radius * .5, 26, Art:Color("Wind", true), 16, .12)
		elseif visual == "BoneKingdom" then
			for i = 1, 8 do local a = i * math.pi / 4; G.Bone(model, Vector3.new(math.cos(a) * radius * .75, 7, math.sin(a) * radius * .75), 15, color) end
		elseif visual == "SpearJudgment" then
			G.Ring(model, radius * .8, 24, color, 24, .12)
		end
	end
	return track(model)
end
function VFX:Add(root)
	if self.Entities[root] then return end
	local now = workspace:GetServerTimeNow()
	if now < (self.Retry[root] or 0) then return end
	local spell = Spells.All[root:GetAttribute("SpellId") or ""]
	if not spell then return end
	local kind = root:GetAttribute("EntityKind")
	local model, spear
	if kind == "Projectile" then model, spear = self:Projectile(root, spell) else model = self:Zone(root, spell) end
	if not model then self.Retry[root] = now + .6; return end
	self.Retry[root] = nil
	model.Parent = self.Folder
	local entry = { Root = root, Model = model, Spell = spell, Kind = kind, Spear = spear, Pulse = 0, CFrame = root.CFrame, Sub = {} }
	self.Entities[root] = entry
	if spell.Visual == "Hawk" then
		entry.Feathers = {}
		for _, part in model:GetDescendants() do
			if part:IsA("BasePart") and (part.Name:match("^WingL_") or part.Name:match("^WingR_")) then
				table.insert(entry.Feathers, { Part = part, Offset = model:GetPivot():ToObjectSpace(part.CFrame), Side = part.Name:match("^WingL_") and -1 or 1 })
			end
		end
	end
	if kind == "Wall" then
		local gui = Instance.new("BillboardGui")
		gui.Size, gui.StudsOffsetWorldSpace, gui.MaxDistance = UDim2.fromOffset(120, 25), Vector3.new(0, 7, 0), 100
		gui.Adornee, gui.Parent = model.PrimaryPart, model
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency, label.TextColor3 = UDim2.fromScale(1, 1), 1, Art:Color("Earth", true)
		label.Font, label.TextSize, label.TextStrokeTransparency, label.Parent = Enum.Font.GothamBold, 13, .3, gui
		entry.HealthLabel = label
	end
	if kind == "Projectile" then
		local a, b = Instance.new("Attachment"), Instance.new("Attachment")
		a.Position, b.Position = Vector3.new(-.3, 0, 0), Vector3.new(.3, 0, 0)
		a.Parent, b.Parent = model.PrimaryPart, model.PrimaryPart
		local trail = Instance.new("Trail")
		trail.Attachment0, trail.Attachment1, trail.Lifetime = a, b, .25
		trail.Color, trail.LightEmission = ColorSequence.new(Art:Color(spell.ElementType), Art:Color(spell.ElementType, true)), .85
		trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, .2), NumberSequenceKeypoint.new(1, 1) })
		trail.Parent = model.PrimaryPart
		local particles = emitter(model.PrimaryPart, Art:Color(spell.ElementType))
		particles.Rate, particles.Speed = 9, NumberRange.new(1, 4)
	end
	if spell.Visual == "BoneKingdom" then
		for _, sign in { -1, 1 } do
			local rib = Art:Clone("BoneArmorUpperTorso", 6)
			if rib then rib.Parent = self.Folder; table.insert(entry.Sub, { Model = rib, Offset = CFrame.new(sign * spell.Radius * .45, 9, 0) }) end
		end
	elseif spell.Visual == "SpearJudgment" and kind ~= "Projectile" then
		for i = 1, 12 do
			local a = i * math.pi / 6
			local spearModel = Art:Clone("WaterSpear", 1.3)
			local point = Vector3.new(math.cos(a) * 23, 25, math.sin(a) * 23)
			if spearModel then spearModel.Parent = self.Folder; table.insert(entry.Sub, { Model = spearModel, Offset = CFrame.lookAt(point, Vector3.zero) * CFrame.Angles(-math.pi / 2, 0, 0), Preview = true }) end
		end
	end
end
function VFX:Remove(root)
	self.Retry[root] = nil
	local entry = self.Entities[root]
	if not entry then return end
	entry.Model:Destroy()
	for _, sub in entry.Sub do sub.Model:Destroy() end
	self.Entities[root] = nil
end
function VFX:DomainStrike(spell, point)
	local model
	if spell.ElementType == "Bone" then model = Art:Clone("BoneHand", .65)
	elseif spell.ElementType == "Ice" then
		model = G.Model("FallingIce")
		for i = -1, 1 do G.Crystal(model, Vector3.new(i * 3, 0, 0), 6, Art:Color("Ice")) end
		model = track(model)
	else model = track(G.Arc(8, Art:Color("Wind"))) end
	if not model then return end
	local bone = spell.ElementType == "Bone"
	model.Parent = self.Folder
	model:PivotTo(CFrame.new(point + Vector3.new(0, bone and -8 or 14, 0)))
	local destination = CFrame.new(point + Vector3.new(0, bone and -2 or 0, 0)) * CFrame.Angles(bone and -.5 or .2, 0, 0)
	local origin = model:GetPivot()
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") then
			TweenService:Create(part, TweenInfo.new(.22, Enum.EasingStyle.Quad), { CFrame = destination * origin:ToObjectSpace(part.CFrame) }):Play()
			task.delay(.25, function() if part.Parent then TweenService:Create(part, TweenInfo.new(.35), { Transparency = 1 }):Play() end end)
		end
	end
	Debris:AddItem(model, .65)
end
function VFX:Cast(character, spell, now)
	local root = character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local state = self.Casts[character]
	for _, model in state.Models or {} do model:Destroy() end
	state.Models = {}
	local circle = track(G.Circle(2.6 + spell.Flavor % 3 * .2, Art:Color(spell.ElementType)))
	if circle then
		circle.Parent = self.Folder
		Art:Attach(circle, root, CFrame.new(0, -2.9, 0), false)
		table.insert(state.Models, circle)
		self:Sound(circle.PrimaryPart, Config.Audio.Cast, .8 + spell.Flavor % 7 * .08)
		Debris:AddItem(circle, math.max(.1, (character:GetAttribute("CastRelease") or now) - now) + .2)
	end
	local hand = character:FindFirstChild("RightHand")
	if hand and (spell.Kind == "Projectile" or spell.Kind == "Volley" or spell.Kind == "Dive") then
		local charge, spear = self:Projectile({ GetAttribute = function(_, key)
			if key == "Visual" then return spell.Visual elseif key == "Radius" then return math.min(spell.Radius, 1) end
		end }, spell)
		if charge then
			charge:ScaleTo(charge:GetScale() * (spell.Visual == "Hawk" and .35 or .5))
			charge.Parent = self.Folder
			Art:Attach(charge, hand, CFrame.new(0, -.4, -.8) * (spear and CFrame.Angles(-math.pi / 2, 0, 0) or CFrame.identity), false)
			table.insert(state.Models, charge)
			Debris:AddItem(charge, math.max(.05, (character:GetAttribute("CastRelease") or now) - now))
		end
	end
end
function VFX:Step(dt)
	local now, camera = workspace:GetServerTimeNow(), workspace.CurrentCamera
	for _, root in CollectionService:GetTagged("BCSpellEntity") do
		if not camera or (camera.CFrame.Position - root.Position).Magnitude <= Config.Limits.VFXDistance then self:Add(root)
		else self:Remove(root) end
	end
	for root, entry in self.Entities do
		if not root.Parent then self:Remove(root); continue end
		local age = now - (root:GetAttribute("StartTime") or now)
		local cf = root.CFrame
		if entry.Kind == "Projectile" then
			entry.CFrame = entry.CFrame:Lerp(cf, 1 - math.exp(-28 * dt))
			cf = entry.CFrame
			if entry.Spear then cf *= CFrame.Angles(-math.pi / 2, 0, 0)
			elseif entry.Spell.Visual ~= "Dragon" and entry.Spell.Visual ~= "Hawk" then cf *= CFrame.Angles(0, 0, age * 8) end
		elseif entry.Kind == "Tornado" or entry.Kind == "Spin" then
			if entry.Kind == "Spin" then local owner = root:FindFirstChild("Owner"); local body = owner and owner.Value and owner.Value:FindFirstChild("HumanoidRootPart"); if body then cf = body.CFrame end end
			cf *= CFrame.Angles(0, age * 5, 0)
		elseif entry.Kind == "Spike" then cf *= CFrame.new(0, -8 * (1 - math.clamp(age / .2, 0, 1)), 0)
		elseif entry.Kind == "Prison" then
			local falling = entry.Spell.ElementType == "Bone"
			cf *= CFrame.new(0, (falling and 22 or -10) * (1 - math.clamp(age / (falling and (entry.Spell.Delay or .45) or .2), 0, 1)), 0)
		elseif entry.Kind == "Hand" then cf *= CFrame.new(0, -14 * (1 - math.clamp(age / .3, 0, 1)), 0) * CFrame.Angles((root:GetAttribute("Phase") or 0) == 2 and -.6 or 0, 0, 0) end
		entry.Model:PivotTo(cf)
		for _, feather in entry.Feathers or {} do
			local hinge = CFrame.new(feather.Side * .65, 0, 0)
			feather.Part.CFrame = cf * hinge * CFrame.Angles(0, 0, feather.Side * math.sin(age * 13) * .3) * hinge:Inverse() * feather.Offset
		end
		if root:GetAttribute("Frosted") and not entry.Frosted then
			entry.Frosted = true
			for _, part in entry.Model:GetDescendants() do if part:IsA("BasePart") and part.Name ~= "Root" then part.Color = part.Color:Lerp(Art:Color("Ice", true), .7); part.Material = Enum.Material.Ice end end
		end
		if entry.HealthLabel then entry.HealthLabel.Text = string.format("СТЕНА · %d / %d", root:GetAttribute("Health") or 0, root:GetAttribute("MaxHealth") or 180) end
		local endTime = root:GetAttribute("EndTime") or now + 1
		if entry.Kind ~= "Projectile" and now > endTime - .25 and not entry.Fading then
			entry.Fading = true
			for _, part in entry.Model:GetDescendants() do if part:IsA("BasePart") then TweenService:Create(part, TweenInfo.new(.25), { Transparency = 1 }):Play() end end
		end
		for _, sub in entry.Sub do
			if sub.Preview and age > .9 then sub.Model:Destroy()
			elseif sub.Model.Parent then sub.Model:PivotTo(root.CFrame * sub.Offset) end
		end
		local pulse = root:GetAttribute("Pulse") or 0
		if pulse ~= entry.Pulse then
			entry.Pulse = pulse
			local point = root:GetAttribute("PulsePosition") or root.Position
			if entry.Kind == "Domain" then
				self:Pulse("Impact", point, entry.Spell.ElementType, entry.Spell.PulseRadius or entry.Spell.Radius)
				self:DomainStrike(entry.Spell, point)
			end
		end
	end
	for _, character in CollectionService:GetTagged("BCActor") do
		local castStart = character:GetAttribute("CastStart") or 0
		local spell = Spells.All[character:GetAttribute("CastSpell") or ""]
		local state = self.Casts[character] or {}
		self.Casts[character] = state
		local body = character:FindFirstChild("HumanoidRootPart")
		local nearby = body and (not camera or (body.Position - camera.CFrame.Position).Magnitude <= Config.Limits.VFXDistance)
		if spell and state.Start ~= castStart then state.Start = castStart; if nearby then self:Cast(character, spell, now) end end
		if not spell then for _, model in state.Models or {} do model:Destroy() end; state.Models = {} end
		local transform = character:GetAttribute("TransformStart") or 0
		if transform > 0 and transform ~= state.Transform then
			state.Transform = transform
			if nearby and now - transform < Config.TransformTime then self:Pulse("Final", body.Position - Vector3.new(0, 2.8, 0), character:GetAttribute("MagicId"), 12); self:Sound(body, Config.Audio.Transform, .7) end
		end
	end
end
function VFX:Start(remote)
	self.Folder = Instance.new("Folder")
	self.Folder.Name, self.Folder.Parent = "LocalMagicVFX", workspace
	CollectionService:GetInstanceRemovedSignal("BCSpellEntity"):Connect(function(root) self:Remove(root) end)
	CollectionService:GetInstanceRemovedSignal("BCActor"):Connect(function(character)
		local state = self.Casts[character]
		if state then for _, model in state.Models or {} do model:Destroy() end end
		self.Casts[character] = nil
	end)
	remote.OnClientEvent:Connect(function(kind, ...) if kind ~= "Notice" then self:Pulse(kind, ...) end end)
	RunService.RenderStepped:Connect(function(dt) self:Step(dt) end)
end
return VFX
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="1369">
          <Properties>
            <string name="Name">VFXController</string>
            <string name="Source"><![CDATA[--!nonstrict
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local Config = require(game:GetService("ReplicatedStorage").BlackClover.Shared.Config)
local VFX = { Active = 0, Actors = {}, Shake = 0 }
local gold = Color3.fromRGB(255, 213, 128)
local mint = Color3.fromRGB(112, 246, 222)

function VFX:Anchor(position, lifetime)
	if self.Active >= 72 then return nil end
	self.Active += 1
	local part = Instance.new("Part")
	part.Name = "LocalEffect"
	part.Size = Vector3.one * 0.15
	part.CFrame = CFrame.new(position)
	part.Anchored, part.CanCollide, part.CanTouch, part.CanQuery = true, false, false, false
	part.Transparency = 1
	part.Parent = self.Folder
	Debris:AddItem(part, lifetime)
	task.delay(lifetime, function() self.Active -= 1 end)
	return part
end

function VFX:Sound(name, parent, pitch)
	local id = Config.Audio[name]
	if not id or id == "" or not parent then return end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = name == "Swing" and 0.15 or 0.3
	sound.PlaybackSpeed = pitch or 1
	sound.RollOffMinDistance, sound.RollOffMaxDistance = 7, 65
	sound.Parent = parent
	sound:Play()
	Debris:AddItem(sound, 2)
end

function VFX:Burst(position, color, strong)
	local anchor = self:Anchor(position, 1.3)
	if not anchor then return end
	local particles = Instance.new("ParticleEmitter")
	particles.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	particles.Color = ColorSequence.new(color, Color3.new(1, 1, 1))
	particles.LightEmission = 0.85
	particles.Lifetime = NumberRange.new(0.15, 0.4)
	particles.Speed = NumberRange.new(8, strong and 24 or 15)
	particles.Drag = 5
	particles.SpreadAngle = Vector2.new(180, 180)
	particles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.32), NumberSequenceKeypoint.new(1, 0) })
	particles.Rate = 0
	particles.Parent = anchor
	particles:Emit(strong and 22 or 12)
	local flash = Instance.new("PointLight")
	flash.Color, flash.Brightness, flash.Range = color, 3, strong and 12 or 7
	flash.Parent = anchor
	TweenService:Create(flash, TweenInfo.new(0.2), { Brightness = 0 }):Play()
	-- A short planar expanding pulse; its geometry stays cosmetic and non-queryable.
	local pulse = Instance.new("Part")
	pulse.Shape = Enum.PartType.Ball
	pulse.Material = Enum.Material.Neon
	pulse.Color, pulse.Transparency = color, 0.55
	pulse.Size = Vector3.new(0.3, 0.3, 0.3)
	pulse.CFrame = CFrame.new(position)
	pulse.Anchored, pulse.CanCollide, pulse.CanQuery, pulse.CanTouch = true, false, false, false
	pulse.Parent = anchor
	TweenService:Create(pulse, TweenInfo.new(0.2), { Size = Vector3.one * (strong and 4.5 or 2.3), Transparency = 1 }):Play()
	return anchor
end

function VFX:Damage(position, damage, color, text)
	local anchor = self:Anchor(position + Vector3.new(0, 2.5, 0), 0.85)
	if not anchor then return end
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(130, 45)
	gui.AlwaysOnTop = true
	gui.Adornee, gui.Parent = anchor, anchor
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
	label.Font, label.TextSize = Enum.Font.GothamBold, 24
	label.TextColor3, label.TextStrokeTransparency = color, 0.6
	label.Text = text or tostring(math.floor(damage + 0.5))
	label.Parent = gui
	TweenService:Create(anchor, TweenInfo.new(0.8), { Position = anchor.Position + Vector3.new(0, 2, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(0.65, Enum.EasingStyle.Quad, Enum.EasingDirection.In, 0, false, 0.15),
		{ TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
end

local function makeTrail(part, color, name, wide)
	local a, b = Instance.new("Attachment"), Instance.new("Attachment")
	a.Name, b.Name = name .. "A", name .. "B"
	a.Position, b.Position = Vector3.new(0, wide, 0), Vector3.new(0, -wide, 0)
	a.Parent, b.Parent = part, part
	local trail = Instance.new("Trail")
	trail.Name = name
	trail.Attachment0, trail.Attachment1 = a, b
	trail.Color = ColorSequence.new(color)
	trail.Lifetime, trail.MinLength, trail.LightEmission = 0.13, 0.05, 0.7
	trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 1) })
	trail.Enabled = false
	trail.Parent = part
	return trail, a, b
end

function VFX:Attach(model)
	if self.Actors[model] then return self.Actors[model] end
	local left, right, root = model:FindFirstChild("LeftHand"), model:FindFirstChild("RightHand"), model:FindFirstChild("HumanoidRootPart")
	if not left or not right or not root then return nil end
	local entry = { Objects = {}, Fists = {} }
	for _, hand in { right, left } do
		local trail, a, b = makeTrail(hand, gold, "FistTrail", 0.3)
		table.insert(entry.Fists, trail)
		for _, object in { trail, a, b } do table.insert(entry.Objects, object) end
	end
	local trail, a, b = makeTrail(root, mint, "SprintTrail", 0.23)
	a.Position, b.Position = Vector3.new(-0.65, 0, 0.4), Vector3.new(0.65, 0, 0.4)
	entry.Sprint = trail
	for _, object in { trail, a, b } do table.insert(entry.Objects, object) end
	self.Actors[model] = entry
	return entry
end

function VFX:Handle(kind, model, position, value, source, index)
	if kind == "Rejected" then return end
	if typeof(position) ~= "Vector3" then return end
	local camera = workspace.CurrentCamera
	if camera and (camera.CFrame.Position - position).Magnitude > Config.Network.MaxVFXDistance then return end
	if kind == "Swing" then
		local definition = Config.Combat.Attacks[value]
		if not definition then return end
		if model:GetAttribute("MeleeProfile") and model:GetAttribute("MeleeProfile") ~= "Fist" then
			self:Sound("Swing", model:FindFirstChild("HumanoidRootPart"), .85)
			return
		end
		local entry = self:Attach(model)
		if not entry then return end
		local trail = entry.Fists[(value == 2 or value == 4) and 2 or 1]
		task.delay(definition.Windup * 0.55, function()
			if trail.Parent then trail.Enabled = true; self:Sound("Swing", trail.Parent, 1.15 + value * 0.06) end
		end)
		task.delay(definition.Windup + definition.Active, function() if trail.Parent then trail.Enabled = false end end)
	elseif kind == "Dash" then
		local anchor = self:Burst(position - Vector3.new(0, 2, 0), mint, false)
		self:Sound("Dash", anchor, 0.85)
	elseif kind == "Restored" then
		self:Burst(position, mint, true)
		self:Damage(position, 0, mint, "ВОССТАНОВЛЕНО")
	else
		local guarded = kind == "Block"
		local broken = kind == "GuardBreak"
		local color = guarded and mint or (broken and Color3.fromRGB(255, 105, 85) or gold)
		local anchor = self:Burst(position, color, broken or index == 4)
		self:Sound(guarded and "Block" or "Hit", anchor, guarded and 1.7 or 0.85)
		self:Damage(position, value or 0, color, broken and "ЗАЩИТА СЛОМАНА" or nil)
		if model == Players.LocalPlayer.Character or source == Players.LocalPlayer.Character then
			self.Shake = math.max(self.Shake, index == 4 and 0.24 or 0.10)
		end
	end
end

function VFX:Step(dt)
	self.Shake *= math.exp(-14 * dt)
	for _, model in CollectionService:GetTagged("BCActor") do
		local entry = self:Attach(model)
		local root = model:FindFirstChild("HumanoidRootPart")
		if entry and root then
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			entry.Sprint.Enabled = humanoid and humanoid.Health > 0 and (model:GetAttribute("Sprinting")
				or (model:GetAttribute("DashUntil") or 0) > workspace:GetServerTimeNow()) and root.AssemblyLinearVelocity.Magnitude > 20
		end
	end
end

function VFX:Start()
	self.Folder = Instance.new("Folder")
	self.Folder.Name, self.Folder.Parent = "LocalVFX", workspace
	CollectionService:GetInstanceRemovedSignal("BCActor"):Connect(function(model)
		local entry = self.Actors[model]
		if entry then for _, object in entry.Objects do object:Destroy() end end
		self.Actors[model] = nil
	end)
end

return VFX
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
