        <Item class="ModuleScript" referent="851">
          <Properties>
            <string name="Name">MagicRules</string>
            <string name="Source"><![CDATA[--!strict
local Rules = {}
function Rules.manaAfter(mana: number, maximum: number, dt: number, awakened: boolean, drain: number, regen: number): number
	local change = awakened and -math.max(0, drain) or math.max(0, regen)
	return math.clamp(mana + change * math.max(0, dt), 0, maximum)
end
function Rules.clash(a: number, b: number, elementA: string, elementB: string): (string, number)
	local pa = a * (elementA == "Anti" and elementB ~= "Anti" and 1.3 or 1)
	local pb = b * (elementB == "Anti" and elementA ~= "Anti" and 1.3 or 1)
	if math.abs(pa - pb) <= math.max(pa, pb) * .15 then return "Equal", 0 end
	return pa > pb and "A" or "B", math.max(1, math.abs(pa - pb) * .75)
end
function Rules.sweptHit(rx: number, ry: number, rz: number, vx: number, vy: number, vz: number, radius: number): (boolean, number)
	local vv = vx * vx + vy * vy + vz * vz
	local t = vv > 1e-9 and math.clamp(-(rx * vx + ry * vy + rz * vz) / vv, 0, 1) or 0
	local x, y, z = rx + vx * t, ry + vy * t, rz + vz * t
	return x * x + y * y + z * z <= radius * radius, t
end
function Rules.cooldown(base: number, element: string, kind: string): number
	return base * (element == "Stars" and kind == "Teleport" and .8 or 1)
end
return Rules
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="852">
          <Properties>
            <string name="Name">PoseLibrary</string>
            <string name="Source"><![CDATA[--!nonstrict
-- Original, asset-free R15 poses. Every transform is relative to the rig's bind pose.
local Config = require(script.Parent.Config)
local Pose = {}
local function r(x, y, z) return CFrame.Angles(math.rad(x or 0), math.rad(y or 0), math.rad(z or 0)) end

local windups = {
	{ Waist = r(-4, 22, 5), RightShoulder = r(35, -18, 12), RightElbow = r(95),
		LeftShoulder = r(45, 10, -18), LeftElbow = r(95), RightHip = r(-12), LeftHip = r(12), LeftKnee = r(-15) },
	{ Waist = r(-3, -25, -5), LeftShoulder = r(40, 20, -12), LeftElbow = r(95),
		RightShoulder = r(45, -10, 18), RightElbow = r(95), RightHip = r(14), LeftHip = r(-12), RightKnee = r(-15) },
	{ Root = r(0, 10, 0), Waist = r(-12, 45, 12), RightShoulder = r(40, -45, 40), RightElbow = r(100),
		LeftShoulder = r(35, 0, -25), LeftElbow = r(85), RightHip = r(-25, -10, 5), LeftHip = r(24, 0, -5), LeftKnee = r(-25) },
	{ Root = r(-5, -12, 0), Waist = r(-15, -38, -10), LeftShoulder = r(30, 25, -55), LeftElbow = r(80),
		RightShoulder = r(50, -10, 20), RightElbow = r(80), RightHip = r(30), LeftHip = r(-25), RightKnee = r(-35) },
}
local impacts = {
	{ Waist = r(-10, -25, -4), Neck = r(3, 20), RightShoulder = r(98, 5, -9), RightElbow = r(5), RightWrist = r(0, 0, -8),
		LeftShoulder = r(40, 0, -15), LeftElbow = r(95), RightHip = r(18), LeftHip = r(-12), RightKnee = r(-20) },
	{ Waist = r(-10, 28, 4), Neck = r(3, -20), LeftShoulder = r(100, -5, 9), LeftElbow = r(5), LeftWrist = r(0, 0, 8),
		RightShoulder = r(42, 0, 15), RightElbow = r(95), RightHip = r(-12), LeftHip = r(20), LeftKnee = r(-20) },
	{ Root = r(0, -10, 0), Waist = r(-14, -48, -9), Neck = r(5, 20), RightShoulder = r(90, 12, -38), RightElbow = r(45),
		LeftShoulder = r(45, 0, -15), LeftElbow = r(90), RightHip = r(28, 12), LeftHip = r(-25), RightKnee = r(-28) },
	{ Root = r(-8, 12, 0), Waist = r(-18, 48, 5), Neck = r(10, -25), LeftShoulder = r(105, -12, 25), LeftElbow = r(12),
		RightShoulder = r(35, 0, 30), RightElbow = r(80), RightHip = r(-22), LeftHip = r(30), LeftKnee = r(-25) },
}

local function blend(a, b, t)
	local result = {}
	for key, value in a do result[key] = value:Lerp(b[key] or CFrame.identity, t) end
	for key, value in b do if not result[key] then result[key] = CFrame.identity:Lerp(value, t) end end
	return result
end

function Pose.Attack(index, age)
	local definition = Config.Combat.Attacks[index]
	if not definition or age < 0 or age > definition.Recovery then return nil end
	local load = definition.Windup * 0.52
	if age < load then return blend({}, windups[index], math.sin(age / load * math.pi / 2)) end
	if age < definition.Windup then
		return blend(windups[index], impacts[index], ((age - load) / (definition.Windup - load)) ^ 2)
	end
	local hold = definition.Windup + definition.Active * 0.6
	if age < hold then return impacts[index] end
	return blend(impacts[index], {}, math.clamp((age - hold) / (definition.Recovery - hold), 0, 1))
end

function Pose.Locomotion(speed, sprint, airborne, phase, localVelocity)
	local pose = {}
	local sway = math.sin(phase)
	if airborne then
		return { Waist = r(-7), RightShoulder = r(15, 0, 30), LeftShoulder = r(15, 0, -30),
			RightElbow = r(30), LeftElbow = r(30), RightHip = r(15), LeftHip = r(-10), RightKnee = r(-35), LeftKnee = r(-15) }
	end
	if speed < 0.7 then
		pose.Waist = r(math.sin(phase * 0.35) * 1.5)
		pose.RightShoulder = r(3, 0, 5)
		pose.LeftShoulder = r(3, 0, -5)
		pose.RightElbow, pose.LeftElbow = r(10), r(10)
		return pose
	end
	local amplitude = sprint and 51 or 29
	local stride = sway * amplitude * math.clamp(speed / 10, 0, 1)
	local sideLean = math.clamp(localVelocity.X / 27, -1, 1) * -9
	pose.Root = CFrame.new(0, math.abs(math.cos(phase)) * (sprint and 0.09 or 0.035), 0)
	pose.Waist = r(sprint and -16 or -4, sway * 5, sideLean)
	pose.Neck = r(sprint and 10 or 2, -sway * 3)
	pose.RightHip, pose.LeftHip = r(stride), r(-stride)
	pose.RightKnee = r(-math.max(0, -sway) * (sprint and 75 or 48))
	pose.LeftKnee = r(-math.max(0, sway) * (sprint and 75 or 48))
	pose.RightAnkle, pose.LeftAnkle = r(-stride * 0.25), r(stride * 0.25)
	pose.RightShoulder, pose.LeftShoulder = r(-stride * 0.8, 0, 6), r(stride * 0.8, 0, -6)
	pose.RightElbow, pose.LeftElbow = r(sprint and 80 or 20), r(sprint and 80 or 20)
	return pose
end

function Pose.Block()
	return { Waist = r(-8), Neck = r(8), RightShoulder = r(65, -15, -15), LeftShoulder = r(65, 15, 15),
		RightElbow = r(75), LeftElbow = r(75), RightHip = r(-12), LeftHip = r(12), LeftKnee = r(-20) }
end

function Pose.Dash()
	return { Waist = r(-28), Neck = r(20), RightShoulder = r(-30, 0, 15), LeftShoulder = r(-30, 0, -15),
		RightElbow = r(15), LeftElbow = r(15), RightHip = r(45), RightKnee = r(-65), LeftHip = r(-25), LeftKnee = r(-20) }
end

function Pose.Stagger(age)
	local weight = math.max(0, 1 - age / 0.32)
	return { Waist = r(18 * weight, 5 * weight, 4 * weight), Neck = r(-15 * weight),
		RightShoulder = r(-12 * weight, 0, 20 * weight), LeftShoulder = r(-12 * weight, 0, -20 * weight) }
end

function Pose.Brake(weight)
	return { Waist = r(12 * weight), Neck = r(-8 * weight), RightHip = r(22 * weight), LeftHip = r(-15 * weight),
		RightKnee = r(-25 * weight), RightShoulder = r(25 * weight), LeftShoulder = r(25 * weight) }
end

return Pose
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="853">
          <Properties>
            <string name="Name">Rules</string>
            <string name="Source"><![CDATA[--!strict
-- Pure simulation rules: exercised by Luau CLI without a Roblox engine.
local Rules = {}

function Rules.finite(value: any): boolean
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Rules.maxMana(base: number, perLevel: number, level: number): number
	return base + math.max(0, math.floor(level) - 1) * perLevel
end

function Rules.regenerate(value: number, maximum: number, rate: number, dt: number): number
	return math.clamp(value + math.max(0, rate) * math.max(0, dt), 0, maximum)
end

function Rules.spend(value: number, cost: number): (boolean, number)
	if not Rules.finite(cost) or cost < 0 or value < cost then
		return false, value
	end
	return true, value - cost
end

function Rules.nextCombo(previous: number, lastAttack: number, now: number, reset: number): number
	if now - lastAttack > reset then return 1 end
	return previous % 4 + 1
end

function Rules.canAct(health: number, now: number, busyUntil: number, stunUntil: number): boolean
	return health > 0 and now >= busyUntil and now >= stunUntil
end

function Rules.consumeToken(tokens: number, lastTime: number, now: number, rate: number, burst: number): (boolean, number)
	local available = math.min(burst, tokens + math.max(0, now - lastTime) * rate)
	if available < 1 then return false, available end
	return true, available - 1
end

function Rules.guardHit(damage: number, guard: number, cost: number, factor: number): (number, number, boolean)
	local remaining = math.max(0, guard - cost)
	if remaining == 0 then return damage, 0, true end
	return damage * factor, remaining, false
end

return table.freeze(Rules)
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="854">
          <Properties>
            <string name="Name">SpellRegistry</string>
            <string name="Source"><![CDATA[--!strict
-- Each entry is a complete spell contract. Executors implement mechanics by Kind.
export type Spell = {
	Id: string, ElementType: string, Slot: string, Awakened: boolean, Name: string, Kind: string,
	ManaCost: number, Cooldown: number, CastTime: number, Recovery: number, Damage: number,
	ClashPower: number, Range: number, HitboxSize: number, Radius: number, Style: string,
	Flavor: number, Speed: number, Duration: number, Tick: number, Count: number, Stun: number,
	Knockback: number, Visual: string, Channel: number, Reflectable: boolean,
	RootTime: number?, [string]: any,
}
type Group = { Base: { [string]: string }, Awakened: { [string]: string } }
local Registry = { All = {} :: { [string]: Spell }, ByMagic = {} :: { [string]: Group } }
local serial = 0
local function spell(element: string, slot: string, awakened: boolean, name: string, kind: string, mana: number, cooldown: number,
	cast: number, damage: number, power: number, range: number, radius: number, style: string, extra: { [string]: any }?)
	serial += 1
	local id = element .. "_" .. (awakened and "A" or "") .. slot
	local definition: Spell = { Id = id, ElementType = element, Slot = slot, Awakened = awakened, Name = name,
		Kind = kind, ManaCost = mana, Cooldown = cooldown, CastTime = cast, Recovery = 0.22,
		Damage = damage, ClashPower = power, Range = range, HitboxSize = radius * 2, Radius = radius,
		Style = style, Flavor = serial, Speed = 85, Duration = 3, Tick = 0.5, Count = 1,
		Stun = 0.15, Knockback = 10, Visual = kind, Channel = 0, Reflectable = true }
	for key, value in extra or {} do definition[key] = value end
	Registry.All[id] = definition
	Registry.ByMagic[element] = Registry.ByMagic[element] or { Base = {}, Awakened = {} }
	local group = Registry.ByMagic[element]
	local slots = awakened and group.Awakened or group.Base
	slots[slot] = id
end

spell("Water", "Z", false, "Водяной шар", "Projectile", 12, 3, .35, 24, 24, 100, 1.4, "Bolt", { Visual = "WaterOrb", Explosion = 6 })
spell("Water", "X", false, "Гнездо морского дракона", "Shield", 18, 10, .45, 0, 42, 0, 6, "Raise", { Duration = 6, Reduction = .45, ShieldHP = 110, Visual = "WaterDome" })
spell("Water", "C", false, "Рёв морского дракона", "Projectile", 24, 8, .7, 36, 48, 115, 3.2, "Dragon", { Visual = "Dragon", Speed = 62, Pierce = true, Stun = .3 })
spell("Water", "V", false, "Копьё морского рыцаря", "DashStrike", 18, 6, .4, 32, 36, 26, 3.5, "Thrust", { Weapon = "WaterSpear", Duration = .3, Speed = 87 })
spell("Water", "Z", true, "Небесный выпад Валькирии", "DashStrike", 20, 5, .28, 58, 70, 44, 5, "Thrust", { Weapon = "WaterSpear", Duration = .38, Speed = 116 })
spell("Water", "X", true, "Танец морских копий", "Spin", 26, 10, .4, 12, 70, 0, 14, "Spin", { Duration = 2.4, Tick = .4, Channel = 2.4, Visual = "SpearDance" })
spell("Water", "C", true, "Божественный дракон", "Dive", 30, 14, .9, 78, 95, 140, 5, "Summon", { Visual = "Dragon", Explosion = 15, Speed = 85 })
spell("Water", "V", true, "Приговор морской богини", "Judgment", 38, 22, 1.1, 12, 110, 110, 24, "Judgment", { Count = 12, Duration = 2.5, Channel = 2.5, FinalDamage = 65, Visual = "SpearJudgment" })

spell("Wind", "Z", false, "Ветряной клинок", "Projectile", 10, 2.8, .22, 22, 21, 120, 1.6, "Slash", { Visual = "WindBlade", Speed = 120 })
spell("Wind", "X", false, "Торнадо", "Tornado", 22, 10, .55, 6, 36, 75, 9, "Raise", { Duration = 4, Tick = .45, Speed = 11, Pull = 20, Visual = "Tornado" })
spell("Wind", "C", false, "Белый ястреб", "Projectile", 18, 7, .5, 30, 30, 130, 2, "Release", { Visual = "Hawk", Speed = 67, Homing = 5, Explosion = 5 })
spell("Wind", "V", false, "Шторм духа", "Volley", 26, 11, .6, 11, 22, 110, 1.8, "Barrage", { Count = 7, Spread = 22, Interval = .1, Visual = "WindBlade", Speed = 110 })
